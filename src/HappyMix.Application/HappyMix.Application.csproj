<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HappyMix.Domain\HappyMix.Domain.csproj" />
    <InternalsVisibleTo Include="HappyMix.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Phasmophobia ghost database (Game features), read by GhostDatabase: English plus uk/ru text. -->
    <EmbeddedResource Include="Phasmophobia\ghosts*.json" LogicalName="HappyMix.Phasmophobia.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
