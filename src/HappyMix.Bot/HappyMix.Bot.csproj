<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.20.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Releases/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HappyMix.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HappyMix.Application\HappyMix.Application.csproj" />
    <ProjectReference Include="..\HappyMix.Infrastructure\HappyMix.Infrastructure.csproj" />
  </ItemGroup>

</Project>
