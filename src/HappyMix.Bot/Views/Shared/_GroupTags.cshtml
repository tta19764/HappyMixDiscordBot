@model IReadOnlyList<string>
@if (Model.Count > 0)
{
    <span class="hm-group-tags" aria-label="@T["Group_tags"]">
        @foreach (string tag in Model)
        {
            bool builtIn = HappyMix.Application.Polls.GroupTags.IsBuiltIn(tag);
            <span class="hm-tag hm-tag--@(builtIn ? tag : "custom")">@DashboardIcons.Tag(tag)@(builtIn ? T["Tag_" + tag].Value : tag)</span>
        }
    </span>
}
