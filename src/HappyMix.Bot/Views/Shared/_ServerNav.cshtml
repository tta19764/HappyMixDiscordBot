@model ServerNavModel
@{
    SideNav.Set(Context, Model.GuildId, Model.GuildName, Model.Active, Model.CanConfigure);
    string guideAnchor = Model.Active == "availability" && Context.Request.Query["view"] == "weekly" ? "weekly" : Model.Active;
}
<div class="hm-page-head">
    <div>
        <nav class="hm-page-head__crumb" aria-label="@T["Breadcrumb"]"><a href="/">@T["Servers"]</a><span aria-hidden="true">/</span><span>@Model.GuildName</span></nav>
        <h1>@T.Message(Model.Title)</h1>
        <p>@Model.Lead <a href="/info?guildId=@Model.GuildId#feature-@guideAnchor">@T["Guide_PageHelp"]</a></p>
    </div>
</div>
