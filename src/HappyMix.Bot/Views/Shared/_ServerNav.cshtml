@model ServerNavModel
<nav class="hm-crumbs" aria-label="Breadcrumb"><a href="/">@T["Servers"]</a><span aria-hidden="true">/</span><span>@Model.GuildName</span></nav>
<div class="hm-page-head" style="margin-bottom: var(--hm-space-4)">
    <div>
        <h1>@T.Message(Model.Title)</h1>
        <p>@Model.Lead</p>
        <a href="/info?guildId=@Model.GuildId#feature-@(Model.Active == "availability" && Context.Request.Query["view"] == "weekly" ? "weekly" : Model.Active)">@T["Guide_PageHelp"]</a>
    </div>
</div>
<nav class="hm-tabs" aria-label="Server">
    <a href="/availability/@Model.GuildId" aria-current="@(Model.Active == "availability" ? "page" : null)">@T["Availability"]</a>
    <a href="/events/@Model.GuildId" aria-current="@(Model.Active == "events" ? "page" : null)">@T["Events"]</a>
    <a href="/game-news/@Model.GuildId" aria-current="@(Model.Active == "game-news" ? "page" : null)">@T["GameNews_Title"]</a>
    <a href="/groups/@Model.GuildId" aria-current="@(Model.Active == "groups" ? "page" : null)">@T["Groups"]</a>
    <a href="/votes/@Model.GuildId" aria-current="@(Model.Active == "votes" ? "page" : null)">@T["Polls_Title"]</a>
    <a href="/links/@Model.GuildId" aria-current="@(Model.Active == "links" ? "page" : null)">@T["Linked_accounts"]</a>
    @if (Model.CanConfigure)
    {
        <a href="/settings/@Model.GuildId" aria-current="@(Model.Active == "settings" ? "page" : null)">@T["Settings"]</a>
    }
</nav>
