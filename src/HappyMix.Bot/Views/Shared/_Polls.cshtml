@using System.Globalization
@using HappyMix.Application.Abstractions.Polls
@using HappyMix.Application.Polls
@using HappyMix.Bot.Services
@model PollsModel
@{
    var board = Model.Board;
    string Localize(string key) => T.Message(key);
    string Icon(string kind) => kind switch { "game" => "🎮", "series" => "📺", "film" => "🎬", "anime" => "🌸", _ => "•" };
    string Span(TimeSpan span) => span.TotalHours >= 24
        ? T["Polls_Span_dh", (int)span.TotalDays, span.Hours].Value
        : span.TotalMinutes >= 60 ? T["Polls_Span_hm", (int)span.TotalHours, span.Minutes].Value : T["Polls_Span_m", Math.Max(1, (int)Math.Ceiling(span.TotalMinutes))].Value;
    string Ago(DateTimeOffset when) => (Model.Now - when).TotalDays >= 1
        ? when.ToLocalTime().ToString("d MMM", CultureInfo.CurrentCulture) : T["Polls_Today"].Value;
    string question = T[board.DefaultQuestion].Value;
    bool startOpen = board.Open.Count == 0;
    string formId = "poll-new-" + (board.GroupId?.ToString("N") ?? "server");
}
<section class="hm-card hm-section hm-stack hm-polls" id="votes" aria-labelledby="votes-title">
    <div class="hm-row hm-row--between">
        <div>
            <h2 id="votes-title">🗳️ @T["Polls_Title"]</h2>
            <p class="hm-help">@T[Model.IsGroup ? "Polls_HelpGroup" : "Polls_HelpServer"]</p>
        </div>
        @if (Model.IsGroup)
        {
            <span class="hm-polls__tags">
                @foreach (string tag in board.Tags)
                {
                    <span class="hm-tag hm-tag--@tag">@(GroupTags.IsBuiltIn(tag) ? T["Tag_" + tag].Value : tag)</span>
                }
                @if (board.CanManageTags)
                {
                    <a class="hm-btn hm-btn--ghost hm-btn--sm" href="#settings">@T[board.Tags.Count == 0 ? "Polls_AddTags" : "Polls_EditTags"]</a>
                }
            </span>
        }
    </div>

    @if (Model.Error is not null)
    {
        <partial name="_Banner" model="@(new BannerModel("error", Model.Error, null, false))" />
    }

    @foreach (var poll in board.Open)
    {
        int voters = Model.VoterCount(poll);
        int max = Math.Max(1, poll.Options.Max(option => poll.Count(option.Position)));
        var mine = Model.Mine(poll);
        <article class="hm-poll" aria-labelledby="poll-@poll.Id.ToString("N")">
            <header class="hm-poll__head">
                <h3 id="poll-@poll.Id.ToString("N")">@poll.Question</h3>
                <p class="hm-help">
                    @T["Polls_By", Model.Names.Name(poll.CreatorId, Localize)] ·
                    @T["Polls_ClosesIn", Span(poll.ClosesAt - Model.Now)] ·
                    @(Model.Electorate(poll) is { } total ? T["Polls_VotedOf", voters, total] : T["Polls_Voted_Count", voters])
                    @if (poll.Multiple) { <span class="hm-badge">@T["Polls_Multiple"]</span> }
                </p>
            </header>
            <form class="hm-stack hm-stack--sm" method="post" action="@Model.VoteUrl(poll)" asp-antiforgery="false">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                <div class="hm-poll__options">
                    @foreach (var option in poll.Options)
                    {
                        int count = poll.Count(option.Position);
                        string names = string.Join(", ", poll.Votes.Where(vote => vote.Position == option.Position).Select(vote => Model.Names.Name(vote.UserId, Localize)));
                        <label class="hm-poll__option @(mine.Contains(option.Position) ? "is-mine" : "")" style="--share: @((count * 100 / max).ToString(CultureInfo.InvariantCulture))%" title="@names">
                            <input type="@(poll.Multiple ? "checkbox" : "radio")" name="choice" value="@option.Position" checked="@mine.Contains(option.Position)">
                            @{ var info = option.Media is { } reference && board.Media.TryGetValue(reference, out var found) ? found : null; }
                            @if (info?.ImageUrl is { } poster)
                            {
                                <img class="hm-poll__poster" src="@poster" alt="" loading="lazy" referrerpolicy="no-referrer">
                            }
                            <span class="hm-poll__label"><span><span aria-hidden="true">@Icon(option.Kind)</span> @option.Label
                                @if (option.Url is { } url)
                                {
                                    <a href="@url" target="_blank" rel="noopener noreferrer" class="hm-poll__link" aria-label="@T["Polls_OpenLink", option.Label]">↗</a>
                                }</span>
                                @if (info is not null)
                                {
                                    <small class="hm-poll__details">@PollMessages.Details(info, Model.Language)</small>
                                }
                                @if (option.Media is { } tracked && board.Progress.TryGetValue(tracked, out var progress))
                                {
                                    <small class="hm-poll__progress">@PollMessages.ProgressLine(progress, Model.Language)</small>
                                }
                            </span>
                            <b class="hm-poll__count">@count</b>
                        </label>
                    }
                </div>
                <div class="hm-row">
                    <button class="hm-btn hm-btn--primary">@DashboardIcons.Render("check")@T[mine.Length == 0 ? "Polls_Vote" : "Polls_ChangeVote"]</button>
                    @if (mine.Length > 0)
                    {
                        <button class="hm-btn hm-btn--ghost" name="clear" value="true">@T["Polls_ClearVote"]</button>
                    }
                </div>
            </form>
            @if (Model.CanClose(poll))
            {
                <form method="post" action="@Model.CloseUrl(poll)" asp-antiforgery="false" class="hm-poll__close">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                    <button class="hm-btn hm-btn--ghost hm-btn--sm">@T["Polls_EndNow"]</button>
                </form>
            }
        </article>
    }

    <details class="hm-poll-new" open="@startOpen">
        <summary class="hm-btn @(startOpen ? "" : "hm-btn--primary")">@DashboardIcons.Render("plus")@T["Polls_Start"]</summary>
        <form class="hm-stack" id="@formId" method="post" action="@Model.NewUrl" asp-antiforgery="false" data-poll-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" value="@Guid.NewGuid()">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
            @if (board.GroupId is { } groupId)
            {
                <input type="hidden" name="groupId" value="@groupId">
            }
            <div class="hm-field">
                <label class="hm-label" for="@formId-question">@T["Polls_Question"]</label>
                <input class="hm-input" id="@formId-question" name="question" maxlength="120" required value="@question">
            </div>

            @if (board.Suggestions.Count > 0)
            {
                <div class="hm-field">
                    <span class="hm-label">@T["Polls_Suggestions"]</span>
                    <div class="hm-poll-suggest" role="group" aria-label="@T["Polls_Suggestions"]">
                        @foreach (var item in board.Suggestions)
                        {
                            string meta = item.TimesWon > 0 && item.LastWon is { } won ? T["Polls_LastPicked", Ago(won)].Value
                                : item.Source == "group" ? T["Polls_FromGroup"].Value
                                : item.Source == "watchlist" ? T["Polls_FromWatchlist"].Value
                                : item.TimesOffered > 0 ? T["Polls_OfferedBefore", item.TimesOffered].Value : "";
                            <button type="button" class="hm-poll-suggest__item" data-suggest="@(item.Url is null ? item.Label : item.Label + " " + item.Url)" aria-pressed="false">
                                <span aria-hidden="true">@Icon(item.Kind)</span> @item.Label
                                @if (meta.Length > 0) { <small>@meta</small> }
                            </button>
                        }
                    </div>
                    <p class="hm-help">@T["Polls_SuggestionsHelp"]</p>
                </div>
            }

            <div class="hm-field hm-media-search" data-media-search data-url="/media/@Model.GuildId/search" data-add-label="@T["Polls_AddThis"]"
                 data-empty="@T["Media_NoResults"]" data-failed="@T["Media_SearchFailed"]" hidden>
                <span class="hm-label">@T["Media_FindTitle"]</span>
                <div class="hm-row hm-media-search__bar">
                    <select class="hm-select" data-media-kind aria-label="@T["Media_Kind"]">
                        <option value="game">🎮 @T["Tag_games"]</option>
                        <option value="series">📺 @T["Tag_series"]</option>
                        <option value="anime">🌸 @T["Tag_anime"]</option>
                        <option value="film">🎬 @T["Tag_films"]</option>
                    </select>
                    <input class="hm-input" type="search" data-media-query placeholder="@T["Media_SearchPlaceholder"]" aria-label="@T["Media_FindTitle"]">
                </div>
                <ul class="hm-media-search__results" data-media-results aria-live="polite"></ul>
            </div>

            <fieldset class="hm-field hm-poll-options" data-poll-options>
                <legend class="hm-label">@T["Polls_Options"]</legend>
                @for (int index = 0; index < PollRules.MaxOptions; index++)
                {
                    <input class="hm-input" name="options" maxlength="300" aria-label="@T["Polls_OptionN", index + 1]"
                           placeholder="@(index == 0 ? T["Polls_OptionPlaceholder"].Value : "")" data-poll-option>
                }
                <button type="button" class="hm-btn hm-btn--ghost hm-btn--sm" data-poll-more hidden>@DashboardIcons.Render("plus")@T["Polls_AddOption"]</button>
                <p class="hm-help">@T["Polls_OptionsHelp"]</p>
            </fieldset>

            <div class="hm-fields hm-poll-new__row">
                <div class="hm-field">
                    <label class="hm-label" for="@formId-minutes">@T["Polls_Closes"]</label>
                    <select class="hm-select" id="@formId-minutes" name="minutes">
                        @foreach (var (minutes, key) in PollDurations.Choices)
                        {
                            <option value="@minutes" selected="@(minutes == 1440)">@T[key]</option>
                        }
                    </select>
                </div>
                <label class="hm-check" style="align-self: end"><input type="checkbox" name="multiple" value="true"><span>@T["Polls_AllowMultiple"]<small>@T["Polls_AllowMultipleHelp"]</small></span></label>
            </div>

            @if (Model.IsGroup)
            {
                <p class="hm-help hm-poll-new__where">💬 @(Model.GroupChannel is { } where ? T["Polls_PostedIn", where] : T["Polls_GroupNoChannel"])</p>
            }
            else
            {
                <div class="hm-field">
                    <label class="hm-label" for="@formId-channel">@T["Polls_PostIn"]</label>
                    <select class="hm-select" id="@formId-channel" name="channelId">
                        <option value="">@T["Polls_DashboardOnly"]</option>
                        @foreach (var (id, name) in Model.Channels)
                        {
                            <option value="@id">#@name</option>
                        }
                    </select>
                    <p class="hm-help">@T["Polls_PostInHelp"]</p>
                </div>
            }
            @if (!Model.IsGroup)
            {
                <fieldset class="hm-field hm-poll-audience" data-poll-audience>
                    <legend class="hm-label">@T["Polls_Who"]</legend>
                    <div class="hm-mode" role="radiogroup">
                        <label><input type="radio" name="audience" value="chosen" checked>@T["Polls_WhoChosen"]</label>
                        <label><input type="radio" name="audience" value="everyone">@T["Polls_WhoEveryone"]</label>
                    </div>
                    <div class="hm-poll-audience__pick">
                        <input class="hm-input" type="search" placeholder="@T["Polls_FindMember"]" aria-label="@T["Polls_FindMember"]" data-member-filter>
                        <div class="hm-checkbox-box hm-poll-audience__list">
                            @foreach (var member in Model.Members)
                            {
                                <label class="hm-check" data-member-name="@member.DisplayName.ToLowerInvariant() @((member.Username ?? "").ToLowerInvariant())">
                                    <input type="checkbox" name="members" value="@member.Id">
                                    <partial name="_Avatar" model="new AvatarModel(member, member.DisplayName, Small: true)" />
                                    <span>@member.DisplayName</span>
                                </label>
                            }
                        </div>
                        <p class="hm-help" data-member-count>@T["Polls_WhoHelp"]</p>
                    </div>
                </fieldset>
            }

            <div><button class="hm-btn hm-btn--primary">🗳️ @T["Polls_StartButton"]</button></div>
        </form>
    </details>

    @if (board.Ended.Count > 0)
    {
        <details class="hm-poll-history">
            <summary>@T["Polls_Earlier", board.Ended.Count]</summary>
            <ul class="hm-poll-history__list">
                @foreach (var poll in board.Ended)
                {
                    var leader = poll.Leader;
                    <li>
                        <span class="hm-poll-history__question">@poll.Question</span>
                        <span class="hm-poll-history__winner">
                            @if (leader is not null)
                            {
                                <span>🏆 @Icon(leader.Kind) @leader.Label</span>
                                <small>@T["Polls_VotesOf", poll.Count(leader.Position), Model.VoterCount(poll)]</small>
                                @if (board.CanManageTags && board.GroupId is { } watchGroup && leader.Kind is "series" or "film" or "anime"
                                     && !(leader.Media is { } known && board.Progress.ContainsKey(known)))
                                {
                                    <form method="post" action="/groups/@Model.GuildId/@watchGroup/watch" asp-antiforgery="false">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="kind" value="@leader.Kind">
                                        <input type="hidden" name="title" value="@leader.Label">
                                        <input type="hidden" name="url" value="@leader.Url">
                                        <input type="hidden" name="source" value="@leader.Media?.Source">
                                        <input type="hidden" name="externalId" value="@leader.Media?.ExternalId">
                                        <button class="hm-btn hm-btn--ghost hm-btn--sm">➕ @T["Watch_AddToList"]</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <small class="hm-subtle">@T["Polls_NoVotes"]</small>
                            }
                        </span>
                        <small class="hm-subtle">@poll.EndedAt.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture)</small>
                    </li>
                }
            </ul>
        </details>
    }
</section>
