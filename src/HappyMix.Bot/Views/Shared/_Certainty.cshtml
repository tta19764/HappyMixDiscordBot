@model bool
<div class="hm-field">
    <label class="hm-label" for="certainty">@T["Certainty"]</label>
    <select class="hm-select" name="tentative" id="certainty" aria-describedby="certainty-help">
        <option value="false" selected="@(!Model)">@T["Definite"]</option>
        <option value="true" selected="@Model">@T["Tentative"]</option>
    </select>
    <p class="hm-help" id="certainty-help">@T["Definite_I_can_play_Tentative_I_might_be_able_to_play"]</p>
</div>
