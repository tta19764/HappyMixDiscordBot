@using HappyMix.Application.Abstractions.Watch
@using HappyMix.Application.Watch
@using HappyMix.Bot.Services
@model WatchModel
@{
    var board = Model.Board;
    Microsoft.AspNetCore.Html.IHtmlContent Icon(string kind) => DashboardIcons.Render(kind switch { "series" => "series", "film" => "films", "anime" => "anime", _ => "watch" });
    var groups = board.Entries.GroupBy(entry => entry.Item.Status).ToDictionary(group => group.Key, group => group.ToArray());
    WatchStatus[] order = [WatchStatus.Watching, WatchStatus.Planned, WatchStatus.Watched, WatchStatus.Dropped];
}
<section class="hm-card hm-section hm-stack hm-watch" id="watchlist" aria-labelledby="watchlist-title">
    <div>
        <h2 id="watchlist-title">@DashboardIcons.Render("watch", cssClass: "hm-heading-icon")@T["Watch_Title"]</h2>
        <p class="hm-help">@T[board.CanEdit ? "Watch_HelpEdit" : "Watch_HelpView"]</p>
    </div>
    @if (Model.Error is not null)
    {
        <partial name="_Banner" model="@(new BannerModel("error", Model.Error, null, false))" />
    }

    @if (board.CanEdit)
    {
        <details class="hm-watch-add" open="@(board.Entries.Count == 0)">
            <summary class="hm-btn">@T["Watch_Add"]</summary>
            <div class="hm-stack hm-watch-add__body">
                <div class="hm-field hm-media-search" data-media-search data-url="/media/@Model.GuildId/search" data-add-label="@T["Watch_AddThis"]"
                     data-empty="@T["Media_NoResults"]" data-failed="@T["Media_SearchFailed"]" data-watch-url="@Model.Url" hidden>
                    <span class="hm-label">@T["Media_FindTitle"]</span>
                    <div class="hm-row hm-media-search__bar">
                        <select class="hm-select" data-media-kind aria-label="@T["Media_Kind"]">
                            <option value="series">@T["Tag_series"]</option>
                            <option value="anime">@T["Tag_anime"]</option>
                            @if (board.SupportsFilms)
                            {
                                <option value="film">@T["Tag_films"]</option>
                            }
                        </select>
                        <input class="hm-input" type="search" data-media-query placeholder="@T["Media_SearchPlaceholder"]" aria-label="@T["Media_FindTitle"]">
                    </div>
                    <ul class="hm-media-search__results" data-media-results aria-live="polite"></ul>
                    @Html.AntiForgeryToken()
                </div>
                <form class="hm-stack hm-stack--sm" method="post" action="@Model.Url" asp-antiforgery="false">
                    @Html.AntiForgeryToken()
                    <span class="hm-label">@T["Watch_OrLink"]</span>
                    <div class="hm-watch-add__manual">
                        <select class="hm-select" name="kind" aria-label="@T["Media_Kind"]">
                            <option value="series">@T["Tag_series"]</option>
                            <option value="anime">@T["Tag_anime"]</option>
                            <option value="film">@T["Tag_films"]</option>
                        </select>
                        <input class="hm-input" name="url" inputmode="url" maxlength="300" placeholder="https://www.imdb.com/title/… · tvmaze.com/shows/… · myanimelist.net/anime/…" aria-label="@T["Watch_Link"]">
                        <input class="hm-input" name="title" maxlength="120" placeholder="@T["Watch_TitlePlaceholder"]" aria-label="@T["Watch_TitleLabel"]">
                        <button class="hm-btn hm-btn--primary">@T["Watch_AddButton"]</button>
                    </div>
                    <p class="hm-help">@T[board.SupportsFilms ? "Watch_LinkHelp" : "Watch_LinkHelpNoFilms"]</p>
                </form>
            </div>
        </details>
    }

    @if (board.Entries.Count == 0)
    {
        <p class="hm-subtle">@T["Watch_Empty"]</p>
    }

    @foreach (var status in order.Where(groups.ContainsKey))
    {
        bool collapsed = status is WatchStatus.Watched or WatchStatus.Dropped;
        <details class="hm-watch-group" open="@(!collapsed)">
            <summary><h3>@T["Watch_Status_" + status] <span class="hm-count">@groups[status].Length</span></h3></summary>
            <div class="hm-watch-list">
                @foreach (var entry in groups[status])
                {
                    var item = entry.Item;
                    var media = entry.Media;
                    bool episodes = WatchKinds.HasEpisodes(item.Kind);
                    int? total = media?.EpisodeCount;
                    <article class="hm-watch-item hm-watch-item--@item.Kind">
                        @if ((item.ImageUrl ?? media?.ImageUrl) is { } poster)
                        {
                            <img class="hm-watch-item__poster" src="@poster" alt="" loading="lazy" referrerpolicy="no-referrer">
                        }
                        else
                        {
                            <span class="hm-watch-item__poster hm-watch-item__poster--empty" aria-hidden="true">@Icon(item.Kind)</span>
                        }
                        <div class="hm-watch-item__body">
                            <h4>
                                @if (item.Url is { } link) { <a href="@link" target="_blank" rel="noopener noreferrer">@item.Title</a> } else { @item.Title }
                            </h4>
                            @if (media is not null)
                            {
                                <p class="hm-help">@Icon(item.Kind) @PollMessages.Details(media, Model.Language)</p>
                            }
                            @if (item.Status != WatchStatus.Watched)
                            {
                                <p class="hm-watch-item__progress">
                                    @if (episodes)
                                    {
                                        <b>@T["Watch_Next", item.Season, item.Episode]</b>
                                        @if (entry.SeasonEpisodes is { } inSeason) { <span class="hm-subtle"> · @T["Watch_OfSeason", inSeason]</span> }
                                    }
                                    @if (item.PositionSeconds is { } seconds)
                                    {
                                        <span class="hm-badge hm-badge--warn">⏸ @T["Watch_StoppedAt", WatchKinds.FormatPosition(seconds)]</span>
                                    }
                                </p>
                                @if (episodes && total is > 0 && entry.EpisodesSeen is { } seen)
                                {
                                    int percent = Math.Clamp(seen * 100 / total.Value, 0, 100);
                                    <div class="hm-watch-item__bar" role="progressbar" aria-valuemin="0" aria-valuemax="@total" aria-valuenow="@seen"
                                         aria-label="@T["Watch_EpisodesSeen", seen, total]" style="--done: @(percent)%"><span></span></div>
                                    <small class="hm-subtle">@T["Watch_EpisodesSeen", seen, total]</small>
                                }
                            }
                            else if (item.FinishedAt is { } finished)
                            {
                                <p class="hm-help">@DashboardIcons.Render("done")@T["Watch_FinishedOn", finished.ToLocalTime().ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentCulture)]</p>
                            }

                            @if (board.CanEdit)
                            {
                                <div class="hm-watch-item__actions">
                                    @if (item.Status != WatchStatus.Watched)
                                    {
                                        <form class="hm-row" method="post" action="@Model.ItemUrl(item)" asp-antiforgery="false">
                                            @Html.AntiForgeryToken()
                                            <button class="hm-btn hm-btn--primary hm-btn--sm" name="action" value="next">
                                                @(episodes ? T["Watch_MarkEpisode", item.Season, item.Episode] : T["Watch_MarkWatched"])
                                            </button>
                                            @if (episodes)
                                            {
                                                <button class="hm-btn hm-btn--sm" name="action" value="finish" data-confirm="@T["Watch_FinishConfirm", item.Title]">@T["Watch_Finish"]</button>
                                            }
                                        </form>
                                    }
                                    <details class="hm-watch-item__edit">
                                        <summary class="hm-btn hm-btn--ghost hm-btn--sm">@T["Watch_Edit"]</summary>
                                        <form class="hm-watch-item__form" method="post" action="@Model.ItemUrl(item)" asp-antiforgery="false">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="action" value="progress">
                                            @if (episodes && entry.Seasons.Count > 0)
                                            {
                                                // The catalog knows the seasons: only real seasons, and episodes up to the season's length.
                                                <label class="hm-field"><span class="hm-label">@T["Watch_Season"]</span>
                                                    <select class="hm-select" name="season" data-season-picker>
                                                        @foreach (var season in entry.Seasons)
                                                        {
                                                            <option value="@season.Number" data-episodes="@season.Episodes" selected="@(season.Number == item.Season)">@T["Watch_SeasonOption", season.Number, season.Episodes]</option>
                                                        }
                                                    </select>
                                                </label>
                                                <label class="hm-field"><span class="hm-label">@T["Watch_Episode"]</span>
                                                    <input class="hm-input hm-tnum" type="number" name="episode" min="1" required data-episode-input
                                                           max="@(entry.SeasonEpisodes ?? entry.Seasons[0].Episodes)" value="@item.Episode"></label>
                                            }
                                            else if (episodes)
                                            {
                                                <label class="hm-field"><span class="hm-label">@T["Watch_Season"]</span><input class="hm-input hm-tnum" type="number" name="season" min="1" max="200" value="@item.Season"></label>
                                                <label class="hm-field"><span class="hm-label">@T["Watch_Episode"]</span><input class="hm-input hm-tnum" type="number" name="episode" min="1" max="5000" value="@item.Episode"></label>
                                            }
                                            <label class="hm-field"><span class="hm-label">@T["Watch_StoppedAtLabel"]</span>
                                                <input class="hm-input hm-tnum" name="position" placeholder="12:30" pattern="\d{1,2}(:\d{2}){0,2}"
                                                       value="@(item.PositionSeconds is { } at ? WatchKinds.FormatPosition(at) : "")"></label>
                                            <button class="hm-btn hm-btn--sm">@T["Save"]</button>
                                        </form>
                                        <form class="hm-row" method="post" action="@Model.ItemUrl(item)" asp-antiforgery="false">
                                            @Html.AntiForgeryToken()
                                            <label class="hm-sr-only" for="status-@item.Id">@T["Watch_StatusLabel"]</label>
                                            <select class="hm-select" id="status-@item.Id" name="status">
                                                @foreach (var option in order)
                                                {
                                                    <option value="@option" selected="@(option == item.Status)">@T["Watch_Status_" + option]</option>
                                                }
                                            </select>
                                            <button class="hm-btn hm-btn--sm" name="action" value="status">@T["Watch_SetStatus"]</button>
                                            <button class="hm-btn hm-btn--ghost hm-btn--sm hm-btn--danger" name="action" value="remove">@T["Watch_Remove"]</button>
                                        </form>
                                    </details>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </details>
    }
</section>
