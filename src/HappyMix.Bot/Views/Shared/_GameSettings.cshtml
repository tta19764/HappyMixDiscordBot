@inject Microsoft.Extensions.Options.IOptions<HappyMix.Bot.Configuration.DiscordOptions> Limits
@model GameSettingsForm
@{
    var settingsPage = (SettingsPage)ViewData["Settings"]!;
    var defaults = (GameDefaults)ViewData["GameDefaults"]!;
    string game = (string)ViewData["GameTitle"]!;
    string sectionId = (string)ViewData["SectionId"]!;
    var state = ViewData.ModelState;
    string Key(string name) => ViewData.TemplateInfo.GetFullHtmlFieldName(name);
    string Id(string name) => FormErrors.Id(Key(name));
    var roles = settingsPage.Roles.Select(role => new SelectListItem("@" + role.Name, role.Id.ToString())).ToArray();
    string roleColors = System.Text.Json.JsonSerializer.Serialize(settingsPage.Roles.ToDictionary(role => role.Id.ToString(), role => role.Color));
    var modes = new[] { (GameSettingsForm.Inherit, T["Inherit"].Value), (GameSettingsForm.Custom, T["Custom"].Value), (GameSettingsForm.None, T["None"].Value) };
    bool catalogOpen = Model.CatalogMode == GameSettingsForm.Custom || FormErrors.Message(state, Key("Catalog")) is not null;
    string searchGame = sectionId == "dota2" ? "dota" : "cs";
    string knownJson = System.Text.Json.JsonSerializer.Serialize(settingsPage.KnownTeams.Select(team => new
        { id = team.Id, name = team.Name, acronym = team.Acronym, location = team.Location, image = team.ImageUrl }));

    var teams = new ListEditorModel("teams", Id("Teams"), Key("Teams"), Model.Teams, Limits.Value.MaxFollowedTeamsPerGame, 4000,
        T["Arg0_followed_teams", game], T["No_teams_yet_Search_for_a_team_by_name_to_add_it"],
        T["Search_for_a_team_by_name"], "Team Vitality\nNatus Vincere #3216",
        T["One_team_per_line_A_name_is_enough_if_several_teams_share"],
        defaults.TeamLines, FormErrors.Invalid(state, Key("Teams")),
        FormErrors.DescribedBy(state, Key("Teams"), Id("Teams") + "-help"),
        $"/settings/{settingsPage.GuildId}/teams?game={searchGame}", knownJson);
    string channelName = sectionId == "dota2" ? "dota2-announcements" : "cs2-announcements";
    var selected = HappyMix.Application.Abstractions.Guilds.StreamDiscoveryPreferences.Split(Model.StreamPriority)
        .Select(item => item.ToLowerInvariant()).Where(item => HappyMix.Application.Abstractions.Guilds.StreamDiscoveryPreferences.Criteria.Contains(item)).Distinct().ToArray();
    var priority = selected.Concat(HappyMix.Application.Abstractions.Guilds.StreamDiscoveryPreferences.Criteria.Except(selected)).ToArray();
    var twitch = new ListEditorModel("twitch", Id("Twitch"), Key("Twitch"), Model.Twitch, Limits.Value.MaxTwitchChannelsPerGame, 1000,
        T["Arg0_Twitch_channels", game], T["No_channels_yet"], T["Twitch_handle_or_twitch_tv_link"], "shroud\nhttps://twitch.tv/esl_csgo",
        T["Settings_TwitchHelp", Limits.Value.MaxTwitchChannelsPerGame], defaults.TwitchLines,
        FormErrors.Invalid(state, Key("Twitch")), FormErrors.DescribedBy(state, Key("Twitch"), Id("Twitch") + "-help"));
}
@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent Chips(string values)
    {
        var items = HappyMix.Application.Abstractions.Guilds.StreamDiscoveryPreferences.Split(values);
        if (items.Length == 0) return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"hm-subtle\">—</span>");
        var builder = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        foreach (var item in items)
        {
            builder.AppendHtml("<span class=\"hm-tag\">");
            builder.Append(item);
            builder.AppendHtml("</span>");
        }
        return builder;
    }
}
<section class="hm-card hm-section" id="@sectionId" aria-labelledby="@sectionId-title">
    <div class="hm-section__head">
        <span class="hm-game-mark" aria-hidden="true">@ViewData["GameMark"]</span>
        <div><h2 id="@sectionId-title">@game</h2><p>@T["Leave_a_value_on_Inherit_to_follow_Server_defaults"]</p></div>
    </div>
    <div class="hm-fields">
        <div class="hm-field @(string.IsNullOrEmpty(Model.Language) ? "hm-field--inherited" : "")" data-source>
            <div class="hm-row hm-row--between">
                <label class="hm-label" asp-for="Language">@T["Notifications_Language"]</label>
                @FormErrors.SourceBadge(string.IsNullOrEmpty(Model.Language) ? GameSettingsForm.Inherit : GameSettingsForm.Custom, T)
            </div>
            <select asp-for="Language" class="hm-select" data-source-control>
                <option value="">@T["Language_CommunityDefault", settingsPage.Community.Language]</option>
                <option value="en">English</option><option value="uk">Українська</option><option value="ru">Русский</option>
            </select>
            <p class="hm-help">@T["Language_GameHelp", game]</p>
        </div>

        <fieldset class="hm-field hm-field--wide hm-streams" data-streams>
            <legend class="hm-label">@T["Streams_Title"]</legend>
            <label class="hm-check hm-check--switch"><input asp-for="DiscoverStreams" data-streams-toggle /><span>@T["Streams_Enable"]<small>@T["Streams_Help"]</small></span></label>
            <div class="hm-streams__body hm-mode-field" data-streams-body>
                <div class="hm-mode" role="radiogroup" aria-label="@T["Streams_ListsSource"]">
                    <label><input type="radio" name="@Key("StreamListsMode")" value="@GameSettingsForm.Inherit" checked="@(Model.StreamListsMode != GameSettingsForm.Custom)">@T["Streams_ListsCommunity"]</label>
                    <label><input type="radio" name="@Key("StreamListsMode")" value="@GameSettingsForm.Custom" checked="@(Model.StreamListsMode == GameSettingsForm.Custom)">@T["Custom"]</label>
                </div>
                <dl class="hm-inherited hm-mode-inherit hm-streams__summary">
                    <div><dt>@T["Streams_Languages"]</dt><dd>@Chips(settingsPage.Community.StreamLanguages)</dd></div>
                    <div><dt>@T["Streams_Countries"]</dt><dd>@Chips(settingsPage.Community.StreamCountries)</dd></div>
                    <div><dt>@T["Streams_Tags"]</dt><dd>@Chips(settingsPage.Community.StreamTags)</dd></div>
                </dl>
                <div class="hm-mode-custom hm-streams__lists">
                    <div class="hm-field">
                        <label class="hm-label" asp-for="StreamLanguages">@T["Streams_Languages"]</label>
                        <input asp-for="StreamLanguages" class="hm-input" placeholder="uk, en" spellcheck="false" autocomplete="off" />
                        <p class="hm-help">@T["Streams_LanguagesHelp"]</p>
                    </div>
                    <div class="hm-field">
                        <label class="hm-label" asp-for="StreamCountries">@T["Streams_Countries"]</label>
                        <input asp-for="StreamCountries" class="hm-input" placeholder="Ukraine, UA" autocomplete="off" />
                        <p class="hm-help">@T["Streams_CountriesHelp"]</p>
                    </div>
                    <div class="hm-field">
                        <label class="hm-label" asp-for="StreamTags">@T["Streams_Tags"]</label>
                        <input asp-for="StreamTags" class="hm-input" placeholder="Ukrainian" autocomplete="off"
                               aria-invalid="@FormErrors.Invalid(state, Key("StreamTags"))" />
                        @FormErrors.Render(state, Key("StreamTags"))
                    </div>
                    <button type="button" class="hm-btn hm-btn--ghost hm-btn--sm" data-fill-defaults
                            data-languages="@settingsPage.Community.StreamLanguages" data-countries="@settingsPage.Community.StreamCountries"
                            data-tags="@settingsPage.Community.StreamTags">@T["Streams_FillCommunity"]</button>
                </div>
                <div class="hm-field hm-priority" data-priority>
                    <label class="hm-label" asp-for="StreamPriority">@T["Streams_Priority"]</label>
                    <input asp-for="StreamPriority" class="hm-input" data-priority-input spellcheck="false"
                           aria-invalid="@FormErrors.Invalid(state, Key("StreamPriority"))" />
                    <ol class="hm-priority__list" data-priority-list hidden>
                        @foreach (var criterion in priority)
                        {
                            <li class="hm-priority__item" data-criterion="@criterion">
                                <label class="hm-check"><input type="checkbox" checked="@selected.Contains(criterion)" /><span>@T["Streams_Criterion_" + criterion]<small>@T["Streams_CriterionHelp_" + criterion]</small></span></label>
                                <span class="hm-priority__moves">
                                    <button type="button" class="hm-btn hm-btn--ghost hm-btn--sm" data-move="-1" aria-label="@T["Move_up"]">↑</button>
                                    <button type="button" class="hm-btn hm-btn--ghost hm-btn--sm" data-move="1" aria-label="@T["Move_down"]">↓</button>
                                </span>
                            </li>
                        }
                    </ol>
                    <p class="hm-help">@T["Streams_PriorityHelp"]</p>
                    @FormErrors.Render(state, Key("StreamPriority"))
                </div>
            </div>
        </fieldset>

        <div class="hm-field @(Model.Channel is null ? "hm-field--inherited" : "")" data-source>
            <div class="hm-row hm-row--between">
                <label class="hm-label" asp-for="Channel">@T["Announcement_channel"]</label>
                @FormErrors.SourceBadge(Model.Channel is null ? GameSettingsForm.Inherit : GameSettingsForm.Custom, T)
            </div>
            <select class="hm-select" asp-for="Channel" asp-items="settingsPage.Channels" data-source-control data-picker
                    data-picker-search="@T["Find_a_channel"]" data-picker-empty="@T["No_channels_match"]"
                    aria-invalid="@FormErrors.Invalid(state, Key("Channel"))" aria-describedby="@FormErrors.DescribedBy(state, Key("Channel"))">
                <option value="">@T["Server_default_Arg0", settingsPage.ServerChannel]</option>
            </select>
            @FormErrors.Render(state, Key("Channel"))
            <label class="hm-check"><input asp-for="CreateChannel" data-create-channel /><span>@T["Notifications_CreateChannelNamed", channelName]</span></label>
        </div>

        <div class="hm-field">
            <label class="hm-label" asp-for="PingRole">@T["Reminder_ping_role"]</label>
            <select class="hm-select" asp-for="PingRole" asp-items="roles" data-picker data-picker-colors="@roleColors"
                    data-picker-search="@T["Find_a_role"]" data-picker-empty="@T["No_roles_match"]"
                    aria-invalid="@FormErrors.Invalid(state, Key("PingRole"))" aria-describedby="@FormErrors.DescribedBy(state, Key("PingRole"))">
                <option value="">@T["No_ping"]</option>
            </select>
            @FormErrors.Render(state, Key("PingRole"))
        </div>

        <div class="hm-field hm-field--wide hm-mode-field" data-source>
            <div class="hm-row hm-row--between">
                <span class="hm-label" id="@Id("Teams")-label">@T["Followed_teams"]</span>
                @FormErrors.SourceBadge(Model.TeamsMode, T)
            </div>
            <div class="hm-mode" role="radiogroup" aria-labelledby="@Id("Teams")-label">
                @foreach (var (value, label) in modes)
                {
                    <label><input type="radio" name="@Key("TeamsMode")" value="@value" checked="@(Model.TeamsMode == value)">@label</label>
                }
            </div>
            <div class="hm-inherited hm-mode-inherit"><span class="hm-inherited__src">@T["Default"]</span><span class="hm-inherited__value">@defaults.Teams</span></div>
            <div class="hm-mode-custom">
                <partial name="_ListEditor" model="teams" />
                @FormErrors.Render(state, Key("Teams"), "margin-top: var(--hm-space-2)")
            </div>
            <div class="hm-inherited hm-mode-none hm-inherited--off">@T["No_Arg0_teams_followed_so_match_posts_for_this_game_stop", game]</div>
        </div>

        <div class="hm-field hm-field--wide hm-mode-field" data-source>
            <div class="hm-row hm-row--between">
                <span class="hm-label" id="@Id("Twitch")-label">@T["Twitch_channels"]</span>
                @FormErrors.SourceBadge(Model.TwitchMode, T)
            </div>
            <div class="hm-mode" role="radiogroup" aria-labelledby="@Id("Twitch")-label">
                @foreach (var (value, label) in modes)
                {
                    <label><input type="radio" name="@Key("TwitchMode")" value="@value" checked="@(Model.TwitchMode == value)">@label</label>
                }
            </div>
            <div class="hm-inherited hm-mode-inherit"><span class="hm-inherited__src">@T["Default"]</span><span class="hm-inherited__value">@defaults.Twitch</span></div>
            <div class="hm-mode-custom">
                <partial name="_ListEditor" model="twitch" />
                @FormErrors.Render(state, Key("Twitch"), "margin-top: var(--hm-space-2)")
            </div>
            <div class="hm-inherited hm-mode-none hm-inherited--off">@T["No_Twitch_links_in_Arg0_announcements", game]</div>
        </div>

        <details class="hm-details hm-field hm-field--wide hm-mode-field" id="@Id("Catalog")-details" data-source open="@catalogOpen">
            <summary>@T["Team_aliases"] @FormErrors.SourceBadge(Model.CatalogMode == GameSettingsForm.Custom ? GameSettingsForm.Custom : GameSettingsForm.Inherit, T)<span class="hm-subtle" style="font-weight: 500">@T["Optional_short_names_for_teams_checked_before_team_search"]</span></summary>
            <div class="hm-mode" role="radiogroup" aria-label="@T["Team_aliases_source"]">
                @foreach (var (value, label) in modes.Take(2))
                {
                    <label><input type="radio" name="@Key("CatalogMode")" value="@value" checked="@((Model.CatalogMode == GameSettingsForm.Custom ? GameSettingsForm.Custom : GameSettingsForm.Inherit) == value)">@label</label>
                }
            </div>
            <div class="hm-inherited hm-mode-inherit"><span class="hm-inherited__src">@T["Default"]</span><span class="hm-inherited__value">@defaults.Catalog</span></div>
            <div class="hm-mode-custom">
                <label class="hm-sr-only" for="@Id("Catalog")">@T["Arg0_team_aliases", game]</label>
                <textarea class="hm-textarea" id="@Id("Catalog")" name="@Key("Catalog")" rows="5" maxlength="16000" placeholder="NAVI=3216"
                          aria-invalid="@FormErrors.Invalid(state, Key("Catalog"))" aria-describedby="@FormErrors.DescribedBy(state, Key("Catalog"), Id("Catalog") + "-help")">@Model.Catalog</textarea>
                <p class="hm-help" id="@Id("Catalog")-help" style="margin-top: var(--hm-space-2)">@T["One_alias_team_number_per_line_for_example_NAVI_3216_Usually_not"]</p>
                @FormErrors.Render(state, Key("Catalog"), "margin-top: var(--hm-space-2)")
            </div>
        </details>
    </div>
</section>
