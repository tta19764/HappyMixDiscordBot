@model GameFeatureInfo
@* The features a game has, as small labels. *@
<span class="hm-gamecard__features">
    @foreach (string feature in Model.Features)
    {
        <span class="hm-ftag">@T[$"Feature_{feature}"]</span>
    }
    @if (Model.Placeholder)
    {
        <span class="hm-ftag hm-ftag--soon">@T["Feature_soon"]</span>
    }
</span>
