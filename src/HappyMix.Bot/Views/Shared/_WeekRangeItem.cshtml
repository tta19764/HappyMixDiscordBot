@model WeekRangeItemModel
@{
    string id = Model.Id;
    // 24-hour hour and minute lists, so every browser shows the same format (a native time input follows the
    // visitor's system locale and may show AM/PM). An unusual saved minute, like :07, is kept as an option.
    var hours = Enumerable.Range(0, 24).Select(hour => hour.ToString("00")).ToArray();
    var start = TimeRangeModel.Split(Model.Start);
    var end = TimeRangeModel.Split(Model.End);
    string[] Minutes(string? current) => Enumerable.Range(0, 12).Select(step => (step * 5).ToString("00"))
        .Append(current ?? "00").Where(value => value.Length == 2).Distinct().Order().ToArray();
    var parts = new[]
    {
        (Which: "start", Label: T["From"].Value, Hour: start?.Hour ?? "", Minute: start?.Minute ?? "00"),
        (Which: "end", Label: T["Until"].Value, Hour: end?.Hour ?? "", Minute: end?.Minute ?? "00")
    };
}
<li class="hm-wrange" data-range-item data-blank="@(Model.Blank ? "true" : "false")">
    <button class="hm-wrange__summary" type="button" data-select-range hidden aria-describedby="@id-preview"></button>
    <div class="hm-wrange__fields" data-range-fields>
        @foreach (var part in parts)
        {
            string name = part.Which == "start" ? "rangeStart" : "rangeEnd";
            <div class="hm-field">
                <span class="hm-label" id="@id-@part.Which-label">@part.Label</span>
                <div class="hm-time-pair" role="group" aria-labelledby="@id-@part.Which-label" data-range-@part.Which>
                    <select class="hm-time-select" id="@id-@part.Which" name="@(name)Hour" aria-label="@part.Label · @T["Hour"]" data-time-hour>
                        <option value="" selected="@(part.Hour == "")">--</option>
                        @foreach (var hour in hours)
                        {
                            <option value="@hour" selected="@(hour == part.Hour)">@hour</option>
                        }
                    </select>
                    <span aria-hidden="true">:</span>
                    <select class="hm-time-select" name="@(name)Minute" aria-label="@part.Label · @T["Minutes"]" data-time-minute>
                        @foreach (var minute in Minutes(part.Minute))
                        {
                            <option value="@minute" selected="@(minute == part.Minute)">@minute</option>
                        }
                    </select>
                </div>
            </div>
        }
        <div class="hm-field">
            <label class="hm-label" for="@id-kind">@T["Certainty"]</label>
            <select class="hm-select" id="@id-kind" name="rangeKind" data-range-kind>
                <option value="definite" selected="@(!Model.Tentative && !Model.DoNotDisturb)">@T["Definite"]</option>
                <option value="tentative" selected="@(Model.Tentative && !Model.DoNotDisturb)">@T["Tentative"]</option>
                <option value="dnd" selected="@Model.DoNotDisturb">@T["Dnd_Title"]</option>
            </select>
        </div>
        <div class="hm-wrange__actions">
            <button class="hm-btn" type="button" data-all-day hidden>@T["All_day"]</button>
            <button class="hm-btn hm-btn--danger" type="button" data-remove-range hidden><span class="hm-btn__label">@T["Remove_range"]</span></button>
        </div>
    </div>
    <p class="hm-help hm-wrange__preview" id="@id-preview" data-range-preview-line aria-live="polite">
        @if (Model.Blank)
        {
            @T["Add_a_range_pick_From_and_Until_00_00_to_00_00_2"]
        }
    </p>
</li>
