@model HappyMix.Bot.Web.DashboardServer[]
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Your servers"; }

<h1>Your servers</h1>
<p>Choose a Discord server to manage your availability.</p>

@if (Model.Length == 0)
{
    <section><p>No shared servers are available. Check that you and HappyMix are in the same Discord server.</p></section>
}
else
{
    <div class="server-grid">
        @foreach (var guild in Model)
        {
            <section class="server-card">
                <div class="server-name">
                    <span class="server-icon" aria-hidden="true">#</span>
                    <h2>@guild.Name</h2>
                </div>
                <div class="actions">
                    <a class="button" href="/availability/@guild.Id">Availability <span aria-hidden="true">→</span></a>
                    @if (guild.CanConfigure)
                    {
                        <a class="button quiet" href="/settings/@guild.Id">Server settings</a>
                    }
                </div>
            </section>
        }
    </div>
}
