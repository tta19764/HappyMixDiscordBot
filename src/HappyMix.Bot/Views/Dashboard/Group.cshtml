@using HappyMix.Application.Guilds
@model GroupPage
@{
    Layout = "_DashboardLayout";
    var group = Model.Group;
    var detail = Model.Detail;
    ViewData["Title"] = group.Name;
    SideNav.Set(ViewData, Model.GuildId, Model.GuildName, "groups", Model.Viewer.CanConfigure);
    string Localize(string key) => T.Message(key);
    string People(IReadOnlyList<ulong> ids) => string.Join(", ", ids.Select(id => Model.Names.Name(id, Localize)));
    var organizerStack = MemberStacks.For(Model, Model.Group.OrganizerId, Localize, small: true);
    BannerModel ErrorBanner(string message) => new("error", message, null, false);
    var organizer = Model.Names.Get(group.OrganizerId);
    string organizerName = Model.Names.Name(group.OrganizerId, Localize);
    bool manage = group.CanManage;
    bool invited = group.Relation == GroupRelation.Invited;
    var leave = new ConfirmModel(T["Leave_group"], T["Leave_Arg0_You_ll_lose_its_Discord_role_until_someone_invites_you", group.Name],
        $"{Model.Url}/leave", T["Leave_Arg0", group.Name], Icon: "logout");
    var close = new ConfirmModel(T["Close_group"],
        T["Close_Arg0_for_everyone_Its_saved_record_games_and_Discord_role_are", group.Name],
        $"{Model.Url}/close", T["Close_Arg0", group.Name]);
}

<div class="hm-page-head">
    <div>
        <nav class="hm-page-head__crumb" aria-label="@T["Breadcrumb"]"><a href="/">@T["Servers"]</a><span aria-hidden="true">/</span><a href="@Model.BackUrl">@T["Groups"]</a><span aria-hidden="true">/</span><span>@group.Name</span></nav>
        <h1>@group.Name</h1>
        <div class="hm-row" style="gap: var(--hm-space-2)">
            <partial name="_GroupBadge" model="(group.Relation, Model.Viewer.CanModerate)" />
            <span class="hm-badge @(group.Open ? "hm-badge--open" : "")">@DashboardIcons.Render(group.Open ? "door" : "lock")@(group.Open ? T["Groups_Open"].Value : T["Groups_InviteOnly"].Value)</span>
            <partial name="_GroupTags" model="Model.Tags" />
        </div>
        <div class="hm-meta">
            <span><partial name="_MemberAvatars" model="organizerStack" />@T["Organizer"]: @organizerName</span>
            <span>@DashboardIcons.Render("users")@T["Arg0_members", group.MemberCount]</span>
            @if (detail.CanViewRoster)
            {
                <span>@DashboardIcons.Render("games")@T["Arg0_games", detail.Games.Length]</span>
            }
        </div>
    </div>
    <a class="hm-btn hm-btn--ghost" href="@Model.BackUrl">@T["All_groups"]</a>
</div>

@if (Model.Banner is { } banner)
{
    <div style="margin-bottom: var(--hm-space-4)"><partial name="_Banner" model="banner" /></div>
}

@if (invited)
{
    <section class="hm-card hm-stack" style="margin-bottom: var(--hm-space-5)" aria-labelledby="invite-title">
        <div>
            <h2 id="invite-title">@T["You_re_invited"]</h2>
            <p class="hm-help">@T["Arg0_invited_you_to_Arg1_Accept_to_see_the_roster_and_games", organizerName, group.Name]</p>
        </div>
        @if (Model.ErrorFor("overview") is { } inviteError)
        {
            <partial name="_Banner" model="ErrorBanner(inviteError)" />
        }
        <form class="hm-row hm-sticky-action" method="post" action="@Model.Url/invitation" asp-antiforgery="false">
            @Html.AntiForgeryToken()
            <button class="hm-btn hm-btn--primary hm-btn--lg" name="decision" value="accept">@T["Accept_invitation"]</button>
            <button class="hm-btn hm-btn--lg" name="decision" value="decline">@T["Decline"]</button>
        </form>
    </section>
}

@{
    bool boardTab = Model.Board is not null && detail.CanViewRoster;
    string defaultTab = Model.Tab == "roster" ? "members" : "overview";
}
<nav class="hm-gtabs" aria-label="@T["Group_sections"]" data-group-tabs data-default-tab="@defaultTab">
    <a class="hm-tab-c-overview" href="#overview" data-tab="overview">@DashboardIcons.Render("overview")@T["Overview"]</a>
    @if (boardTab)
    {
        <a class="hm-tab-c-availability" href="@Model.DayUrl(Model.Board!.Date)" data-tab="availability">@DashboardIcons.Render("availability")@T["Availability"]</a>
    }
    <a class="hm-tab-c-members" href="@(boardTab ? Model.TabUrl("roster") : "#members")" data-tab="members">@DashboardIcons.Render("groups")@T["Members"] <span class="hm-count">@group.MemberCount</span></a>
    @if (Model.Detail.CanViewRoster)
    {
        <a class="hm-tab-c-events" href="#events" data-tab="events">@DashboardIcons.Render("events")@T["Events"] <span class="hm-count">@Model.Events.Count</span></a>
    }
    @if (Model.Polls is not null)
    {
        <a class="hm-tab-c-votes" href="#votes" data-tab="votes">@DashboardIcons.Render("votes")@T["Polls_Title"] <span class="hm-count">@Model.Polls.Board.Open.Count</span></a>
    }
    @if (Model.Watch is not null)
    {
        <a class="hm-tab-c-watchlist" href="#watchlist" data-tab="watchlist">@DashboardIcons.Render("watch")@T["Watch_Title"]</a>
    }
    <a class="hm-tab-c-games" href="#games" data-tab="games">@DashboardIcons.Render("games")@T["Games"]
        @if (detail.CanViewRoster)
        {
            <span class="hm-count">@detail.Games.Length</span>
        }
    </a>
    @if (Model.Stats is { } statsTab)
    {
        <a class="hm-tab-c-stats" href="#stats" data-tab="stats">@DashboardIcons.Render("stats")@T["Stats_Title"]
            @if (statsTab.Sharing > 0)
            {
                <span class="hm-count">@statsTab.Sharing</span>
            }
        </a>
    }
    @if (Model.Live is { } liveTab)
    {
        <a class="hm-tab-c-live" href="#live" data-tab="live">@DashboardIcons.Render("live")@T["Live_Title"]
            @if (liveTab.State.Playing.Count > 0)
            {
                <span class="hm-count hm-count--live">@liveTab.State.Playing.Count</span>
            }
        </a>
    }
    @if (manage || Model.Notifications is not null)
    {
        <a class="hm-tab-c-settings" href="#settings" data-tab="settings">@DashboardIcons.Render("settings")@T["Group_settings"]</a>
    }
</nav>

<div class="hm-stack" style="gap: var(--hm-space-6)">
    @* ---------- Overview ---------- *@
    <section class="hm-card hm-section hm-stack" id="overview" aria-labelledby="overview-title" data-group-panel="overview">
        <h2 id="overview-title">@T["Overview"]</h2>
        <p class="@(group.Description is null ? "hm-subtle" : "")">@(group.Description ?? T["No_description"].Value)</p>
        @if (group.Open && group.Relation is HappyMix.Application.Guilds.GroupRelation.None or HappyMix.Application.Guilds.GroupRelation.Requested)
        {
            <form class="hm-row hm-join" method="post" action="@Model.Url/@(group.Relation == HappyMix.Application.Guilds.GroupRelation.Requested ? "join/cancel" : "join")" asp-antiforgery="false">
                @Html.AntiForgeryToken()
                @if (group.Relation == HappyMix.Application.Guilds.GroupRelation.Requested)
                {
                    <span class="hm-help">@DashboardIcons.Render("clock")@T["Groups_RequestPending"]</span>
                    <button class="hm-btn">@T["Groups_CancelRequest"]</button>
                }
                else
                {
                    <span class="hm-help">@T["Groups_OpenHelp"]</span>
                    <button class="hm-btn hm-btn--primary">@T["Groups_RequestToJoin"]</button>
                }
            </form>
        }

        @if (detail.CanLeave || manage)
        {
            <hr class="hm-divider" style="margin: 0">
            <div class="hm-row hm-row--between">
                @if (detail.CanLeave)
                {
                    <p class="hm-help">@T["You_can_leave_at_any_time_The_organizer_can_invite_you_back"]</p>
                    <partial name="_Confirm" model="leave" />
                }
                else if (group.Relation == GroupRelation.Organizer)
                {
                    <p class="hm-help">@T["You_organize_this_group_To_leave_it_close_the_group"]</p>
                }
            </div>
        }
    </section>

    @* ---------- Members ---------- *@
    @if (manage && detail.JoinRequests.Length > 0)
    {
        <section class="hm-card hm-section hm-stack hm-join-requests" id="requests" aria-labelledby="requests-title" data-group-panel="overview members">
            <h2 id="requests-title">@DashboardIcons.Render("request", cssClass: "hm-heading-icon")@T["Groups_JoinRequests"] <span class="hm-count">@detail.JoinRequests.Length</span></h2>
            <ul class="hm-roster">
                @foreach (ulong requester in detail.JoinRequests)
                {
                    string requesterName = Model.Names.Name(requester, Localize);
                    <li class="hm-roster__item">
                        <partial name="_Avatar" model="new AvatarModel(Model.Names.Get(requester), requesterName, Small: true)" />
                        <span class="hm-roster__name">@requesterName</span>
                        <form class="hm-row" method="post" action="@Model.Url/requests/@requester" asp-antiforgery="false">
                            @Html.AntiForgeryToken()
                            <button class="hm-btn hm-btn--primary hm-btn--sm" name="approve" value="true">@T["Groups_Approve"]</button>
                            <button class="hm-btn hm-btn--sm" name="approve" value="false">@T["Decline"]</button>
                        </form>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="hm-card hm-section hm-stack @(Model.ShowRoster ? "" : "hm-panel-availability")" id="members" aria-labelledby="members-title" data-group-panel="@(Model.ShowRoster ? "members" : "availability")">
        <div class="hm-card__head" style="margin: 0">
            <h2 id="members-title">@T["Members"]</h2>
            <span class="hm-badge hm-tnum">@T["Arg0_members", group.MemberCount]</span>
        </div>
        @if (!detail.CanViewRoster)
        {
            <div class="hm-empty" style="padding: var(--hm-space-6) var(--hm-space-4)">
                <span class="hm-empty__icon">@DashboardIcons.Render("shield")</span>
                <p>@T["Accept_the_invitation_to_see_who_s_in_this_group"]</p>
            </div>
        }
        else
        {
            @if (Model.ErrorFor("members") is { } membersError)
            {
                <partial name="_Banner" model="ErrorBanner(membersError)" />
            }
            @if (!Model.Names.Available)
            {
                <p class="hm-help">@DashboardIcons.Render("info") @T["Discord_didn_t_return_the_member_list_so_names_are_shown_as"]</p>
            }
            @if (!Model.ShowRoster)
            {
                <partial name="_AvailabilityBoard" model="Model" />
            }
            else
            {
            <h3 id="roster" class="hm-sr-only">@T["Roster"]</h3>
            <ul class="hm-roster" aria-label="@T["Roster"]">
                @foreach (ulong id in detail.Members.OrderBy(id => id == group.OrganizerId ? 0 : 1).ThenBy(id => Model.Names.Name(id, Localize), StringComparer.CurrentCultureIgnoreCase))
                {
                    var profile = Model.Names.Get(id);
                    string name = Model.Names.Name(id, Localize);
                    bool isOrganizer = id == group.OrganizerId;
                    var avatar = MemberStacks.For(Model, id, Localize);
                    var remove = new ConfirmModel(T["Remove"], T["Remove_Arg0_from_Arg1_Their_group_role_is_removed_too", name, group.Name],
                        $"{Model.Url}/members/{id}/remove", T["Remove_Arg0", name], TriggerLabel: T["Remove_Arg0", name]);
                    var repair = new ConfirmModel(T["Repair_roles"],
                        T["Reapply_group_roles_for_Arg0_only_Nobody_else_is_changed", name],
                        $"{Model.Url}/members/{id}/repair", T["Repair_Arg0_s_roles", name], Icon: "refresh", Danger: false,
                        TriggerLabel: T["Repair_roles_for_Arg0", name]);
                    <li class="hm-roster__item">
                        <partial name="_MemberAvatars" model="avatar" />
                        <div class="hm-roster__who">
                            <span class="hm-roster__name">
                                @name
                                @if (isOrganizer)
                                {
                                    <span class="hm-badge hm-badge--custom">@T["Organizer"]</span>
                                }
                                @if (id == Model.Viewer.UserId)
                                {
                                    <span class="hm-badge">@T["You"]</span>
                                }
                            </span>
                            <span class="hm-roster__sub">
                                @if (profile.InServer && profile.Username is { } username)
                                {
                                    @("@" + username)
                                }
                                @if (Model.Detail.LinkedAccounts.TryGetValue(id, out var linkedIds))
                                {
                                    <span class="hm-roster__linked">· @T["Arg0_linked", linkedIds.Length]</span>
                                }
                                else if (!profile.InServer && Model.Names.Available)
                                {
                                    @T["No_longer_in_this_server"]
                                }
                            </span>
                        </div>
                        @if (manage && !isOrganizer || Model.Viewer.CanModerate)
                        {
                            <div class="hm-roster__actions">
                                @if (Model.Viewer.CanModerate && (profile.InServer || !Model.Names.Available))
                                {
                                    <partial name="_Confirm" model="repair" />
                                }
                                @if (manage && !isOrganizer)
                                {
                                    <partial name="_Confirm" model="remove" />
                                }
                            </div>
                        }
                    </li>
                }
            </ul>

            @if (manage)
            {
                string? memberValue = Model.Form?.Section == "members" ? Model.Form.Member : null;
                <hr class="hm-divider" style="margin: 0">
                <form class="hm-stack hm-stack--sm" method="post" action="@Model.Url/invite" asp-antiforgery="false" aria-labelledby="invite-form-title">
                    @Html.AntiForgeryToken()
                    <h3 id="invite-form-title">@T["Invite_someone"]</h3>
                    <label class="hm-label" for="invite-member">@T["Discord_username"]</label>
                    <div class="hm-search" style="max-width: none">
                        <input class="hm-input" id="invite-member" name="member" list="invite-candidates" required autocomplete="off"
                               spellcheck="false" value="@memberValue" placeholder="@T["Start_typing_a_name"]" aria-describedby="invite-help">
                        <button class="hm-btn hm-btn--primary">@T["Invite"]</button>
                    </div>
                    <p class="hm-help" id="invite-help">@T["They_get_a_Discord_message_with_Accept_and_Decline_buttons_Nobody_joins"]</p>
                    <datalist id="invite-candidates">
                        @foreach (var candidate in Model.InviteCandidates)
                        {
                            <option value="@candidate.Username">@candidate.DisplayName</option>
                        }
                    </datalist>
                </form>

                <div class="hm-stack hm-stack--sm">
                    <h3>@T["Pending_invitations"]</h3>
                    @if (detail.Invites.Length == 0)
                    {
                        <p class="hm-help">@T["No_pending_invitations_2"]</p>
                    }
                    else
                    {
                        <ul class="hm-roster">
                            @foreach (ulong id in detail.Invites)
                            {
                                var profile = Model.Names.Get(id);
                                string name = Model.Names.Name(id, Localize);
                                var avatar = MemberStacks.For(Model, id, Localize);
                                var revoke = new ConfirmModel(T["Revoke"], T["Revoke_Arg0_s_invitation_to_Arg1_Their_Accept_button_will_stop_working", name, group.Name],
                                    $"{Model.Url}/members/{id}/remove?kind=invite", T["Revoke_invitation"], Icon: "trash", TriggerLabel: T["Revoke_Arg0_s_invitation", name]);
                                <li class="hm-roster__item">
                                    <partial name="_MemberAvatars" model="avatar" />
                                    <div class="hm-roster__who">
                                        <span class="hm-roster__name">@name <span class="hm-badge hm-badge--warn">@T["Invited"]</span></span>
                                        <span class="hm-roster__sub">@(profile.Username is { } u ? "@" + u : "")</span>
                                    </div>
                                    <div class="hm-roster__actions"><partial name="_Confirm" model="revoke" /></div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
            }
        }
    </section>

    @* ---------- Events ---------- *@
    @if (Model.Detail.CanViewRoster)
    {
        ViewData["GuildId"] = Model.GuildId;
        <section class="hm-card hm-section hm-stack hm-panel-events" id="events" aria-labelledby="events-title" data-group-panel="events">
            <div class="hm-card__head" style="margin: 0">
                <div><h2 id="events-title">@T["Events"]</h2><p>@T["Sessions_planned_for_this_group_pending_until_the_organizer_confirms"]</p></div>
                <a class="hm-btn hm-btn--sm" href="/events/@Model.GuildId/new?group=@group.Id">@T["Plan_an_event"]</a>
            </div>
            @if (Model.Events.Count == 0)
            {
                <p class="hm-empty-note">@T["No_events_planned_for_this_group_yet"]</p>
            }
            else
            {
                <ul class="hm-events">
                    @foreach (var row in Model.Events)
                    {
                        <partial name="_EventRow" model="row" view-data='new ViewDataDictionary(ViewData) { ["Actions"] = row.MyAnswer == true ? "withdraw" : "answer", ["ReturnUrl"] = Context.Request.Path + Context.Request.QueryString + "#events" }' />
                    }
                </ul>
            }
        </section>
    }

    @* ---------- Games ---------- *@
    @if (Model.Polls is { } polls)
    {
        <div class="hm-panel-votes" data-group-panel="votes"><partial name="_Polls" model="polls" /></div>
    }
    @if (Model.Watch is { } watch)
    {
        <div class="hm-panel-watchlist" data-group-panel="watchlist"><partial name="_Watchlist" model="watch" /></div>
    }

    <section class="hm-card hm-section hm-stack" id="games" aria-labelledby="games-title" data-group-panel="games">
        <h2 id="games-title">@T["Games"]</h2>
        @if (!detail.CanViewRoster)
        {
            <p class="hm-help">@T["Accept_the_invitation_to_see_the_group_s_games"]</p>
        }
        else
        {
            @if (Model.ErrorFor("games") is { } gamesError)
            {
                <partial name="_Banner" model="ErrorBanner(gamesError)" />
            }
            @if (detail.Games.Length == 0)
            {
                <div class="hm-empty" style="padding: var(--hm-space-6) var(--hm-space-4)">
                    <span class="hm-empty__icon">@DashboardIcons.Render("calendar")</span>
                    <p>@(manage ? T["No_games_yet_Add_what_the_group_plays_below"] : T["No_games_attached_yet"])</p>
                </div>
            }
            else
            {
                <ul class="hm-roster" aria-label="@T["Attached_games"]">
                    @foreach (var game in detail.Games)
                    {
                        string formKey = "game-" + game.Id.ToString("N");
                        bool editing = Model.Form?.Section == formKey;
                        var removeGame = new ConfirmModel(T["Remove"], T["Remove_Arg0_from_Arg1", game.Name, group.Name],
                            $"{Model.Url}/games/{game.Id}/remove", T["Remove_Arg0", game.Name], TriggerLabel: T["Remove_Arg0", game.Name]);
                        <li class="hm-game-row" id="@formKey">
                            <div class="hm-game-row__main">
                                <span class="hm-game-row__name">@game.Name</span>
                                <span class="hm-game-row__meta">
                                    @if (game.SteamAppId is { } appId)
                                    {
                                        <span class="hm-badge">Steam · @appId</span>
                                        <a href="@SteamApps.StoreUrl(appId)" target="_blank" rel="noopener noreferrer">@T["View_on_Steam"] ↗<span class="hm-sr-only"> (@T["Opens_in_a_new_tab"])</span></a>
                                    }
                                    else if (Model.GameDetails.TryGetValue(game.Id, out var gameInfo))
                                    {
                                        @foreach (string platform in gameInfo.Platforms ?? [])
                                        {
                                            <span class="hm-badge">@platform</span>
                                        }
                                        @if (gameInfo.Url is { } gameUrl)
                                        {
                                            <a href="@gameUrl" target="_blank" rel="noopener noreferrer">@T["Groups_GamePage"] ↗<span class="hm-sr-only"> (@T["Opens_in_a_new_tab"])</span></a>
                                        }
                                    }
                                    else
                                    {
                                        <span>@T["Groups_NoStoreLink"]</span>
                                    }
                                </span>
                                @if (Model.Interest?.Games.GetValueOrDefault(game.Id) is { } interest)
                                {
                                    <span class="hm-interest">
                                        @if (interest.Any)
                                        {
                                            <span class="hm-interest__want" title="@People(interest.Want)">@T["Games_GroupWant", interest.Want.Count]</span>
                                            <span class="hm-interest__can" title="@People(interest.Can)">@T["Games_GroupCan", interest.Can.Count]</span>
                                            <span class="hm-interest__wont" title="@People(interest.Wont)">@T["Games_GroupWont", interest.Wont.Count]</span>
                                        }
                                        else
                                        {
                                            <span class="hm-subtle">@T["Games_NoMarks"]</span>
                                        }
                                    </span>
                                }
                            </div>
                            @if (manage)
                            {
                                <div class="hm-roster__actions">
                                    <partial name="_Confirm" model="removeGame" />
                                </div>
                                <details class="hm-game-row__edit" open="@editing">
                                    <summary class="hm-link-btn">@(game.SteamAppId is null ? T["Edit_or_link_Steam"] : T["Edit"])</summary>
                                    <form class="hm-inline-form" method="post" action="@Model.Url/games/@game.Id" asp-antiforgery="false" style="margin-top: var(--hm-space-2)">
                                        @Html.AntiForgeryToken()
                                        <div class="hm-field">
                                            <label class="hm-label" for="@formKey-name">@T["Game_name"]</label>
                                            <input class="hm-input" id="@formKey-name" name="name" required maxlength="60" value="@(editing ? Model.Form!.Name : game.Name)">
                                        </div>
                                        <div class="hm-field">
                                            <label class="hm-label" for="@formKey-steam">@T["Steam_App_ID_or_link"] <span class="hm-label__opt">@T["Optional"]</span></label>
                                            <input class="hm-input" id="@formKey-steam" name="steam" maxlength="200" inputmode="url" value="@(editing ? Model.Form!.Steam : game.SteamAppId)">
                                        </div>
                                        <button class="hm-btn">@T["Save"]</button>
                                    </form>
                                    @if (editing && Model.Form!.Error is { } editError)
                                    {
                                        <p class="hm-error" style="margin-top: var(--hm-space-2)">@DashboardIcons.Render("alert")@editError</p>
                                    }
                                </details>
                            }
                        </li>
                    }
                </ul>
            }

            @if (Model.Interest is { Popular.Count: > 0 } wanted)
            {
                <div class="hm-suggestions">
                    <h3 class="hm-row" style="gap: var(--hm-space-2)">@DashboardIcons.Render("trophy", cssClass: "hm-heading-icon")@T["Games_Popular"]</h3>
                    <p class="hm-help">@T["Games_PopularHelp"]</p>
                    <ul class="hm-roster">
                        @foreach (var popular in wanted.Popular)
                        {
                            <li class="hm-roster__item">
                                <span class="hm-roster__name"><span class="hm-roster__game">@DashboardIcons.Render("games")@popular.Name</span>
                                    <small class="hm-interest"><span class="hm-interest__want" title="@People(popular.Want)">@T["Games_GroupWant", popular.Want.Count]</span>
                                        @if (popular.Wont.Count > 0)
                                        {
                                            <span class="hm-interest__wont" title="@People(popular.Wont)">@T["Games_GroupWont", popular.Wont.Count]</span>
                                        }
                                    </small></span>
                                <form method="post" action="@Model.Url/@(manage ? "games" : "suggest")" asp-antiforgery="false">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="name" value="@popular.Name">
                                    <input type="hidden" name="provider" value="@popular.Provider">
                                    <input type="hidden" name="externalId" value="@popular.ExternalId">
                                    <input type="hidden" name="steam" value="@(popular.Provider == "steam" ? popular.ExternalId : null)">
                                    <button class="hm-btn hm-btn--sm @(manage ? "hm-btn--primary" : "")">@T[manage ? "Groups_AddSuggested" : "Groups_SendSuggestion"]</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (detail.CanViewRoster)
            {
                <p class="hm-help"><a href="/games/@Model.GuildId">@T["Games_MarkYours"]</a></p>
            }

            @if (detail.Suggestions.Length > 0)
            {
                <div class="hm-suggestions">
                    <h3 class="hm-row" style="gap: var(--hm-space-2)">@DashboardIcons.Render("idea", cssClass: "hm-heading-icon")@T["Groups_Suggestions"] <span class="hm-count">@detail.Suggestions.Length</span></h3>
                    <ul class="hm-roster">
                        @foreach (var suggestion in detail.Suggestions)
                        {
                            <li class="hm-roster__item">
                                <span class="hm-roster__name"><span class="hm-roster__game">@DashboardIcons.Render("games")@suggestion.Name</span>
                                    <small class="hm-subtle">@T["Groups_SuggestedBy", Model.Names.Name(suggestion.SuggestedBy, Localize)]</small></span>
                                @if (manage)
                                {
                                    <form class="hm-row" method="post" action="@Model.Url/suggestions/@suggestion.Id" asp-antiforgery="false">
                                        @Html.AntiForgeryToken()
                                        <button class="hm-btn hm-btn--primary hm-btn--sm" name="accept" value="true">@T["Groups_AddSuggested"]</button>
                                        <button class="hm-btn hm-btn--sm" name="accept" value="false">@T["Groups_Dismiss"]</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            bool adding = Model.Form?.Section is "games" or "suggest";
            string gameAction = manage ? "games" : "suggest";
            <hr class="hm-divider" style="margin: 0">
            <form class="hm-stack hm-stack--sm" method="post" action="@Model.Url/@gameAction" asp-antiforgery="false" aria-labelledby="add-game-title" data-game-form>
                @Html.AntiForgeryToken()
                <h3 id="add-game-title">@T[manage ? "Add_a_game" : "Groups_SuggestGame"]</h3>
                @if (!manage)
                {
                    <p class="hm-help">@T["Groups_SuggestHelp"]</p>
                }
                <div class="hm-field hm-media-search" data-media-search data-game-picker data-url="/media/@Model.GuildId/search" data-add-label="@T["Groups_PickGame"]"
                     data-empty="@T["Media_NoResults"]" data-failed="@T["Media_SearchFailed"]" hidden>
                    <span class="hm-label">@T["Groups_FindGame"]</span>
                    <div class="hm-row hm-media-search__bar">
                        <select class="hm-select" data-media-kind aria-label="@T["Media_Kind"]" hidden><option value="game" selected>@T["Tag_games"]</option></select>
                        <input class="hm-input" type="search" data-media-query placeholder="League of Legends, Fortnite, Counter-Strike 2…" aria-label="@T["Groups_FindGame"]">
                    </div>
                    <ul class="hm-media-search__results" data-media-results aria-live="polite"></ul>
                </div>
                <input type="hidden" name="provider" data-game-provider>
                <input type="hidden" name="externalId" data-game-id>
                <div class="hm-inline-form">
                    <div class="hm-field">
                        <label class="hm-label" for="game-name">@T["Game_name"]</label>
                        <input class="hm-input" id="game-name" name="name" required maxlength="60" value="@(adding ? Model.Form!.Name : null)" placeholder="League of Legends" data-game-name>
                    </div>
                    <div class="hm-field">
                        <label class="hm-label" for="game-steam">@T["Steam_App_ID_or_link"] <span class="hm-label__opt">@T["Optional"]</span></label>
                        <input class="hm-input" id="game-steam" name="steam" maxlength="200" inputmode="url" value="@(adding ? Model.Form!.Steam : null)"
                               placeholder="730" aria-describedby="game-steam-help" data-game-steam>
                    </div>
                    <button class="hm-btn hm-btn--primary">@T[manage ? "Add_game" : "Groups_SendSuggestion"]</button>
                </div>
                <p class="hm-help" id="game-steam-help">@T["Groups_GameHelp"]</p>
                @if (Model.ErrorFor("suggest") is { } suggestError)
                {
                    <p class="hm-error">@DashboardIcons.Render("alert")@suggestError</p>
                }
            </form>
        }
    </section>

    @* ---------- Live (members) ---------- *@
    @if (Model.Live is { } live)
    {
        var state = live.State;
        <section class="hm-card hm-section hm-stack hm-live" id="live" aria-labelledby="live-title" data-group-panel="live">
            <div>
                <h2 id="live-title">@DashboardIcons.Render("live", cssClass: "hm-heading-icon")@T["Live_Title"]</h2>
                <p class="hm-help">@T["Live_Lead"]</p>
            </div>
            @if (Model.ErrorFor("live") is { } liveError)
            {
                <partial name="_Banner" model="ErrorBanner(liveError)" />
            }

            <div class="hm-live__now">
                <h3>@T["Live_PlayingNow"]</h3>
                @if (state.Playing.Count == 0)
                {
                    <p class="hm-help">@(state.Sharers == 0 ? T["Live_NobodyShares"] : T["Live_NobodyPlaying", state.Sharers])</p>
                }
                else
                {
                    <ul class="hm-live__list">
                        @foreach (var player in state.Playing)
                        {
                            <li class="hm-live__item">
                                <span class="hm-live__dot" aria-hidden="true"></span>
                                <span class="hm-live__who">@Model.Names.Name(player.UserId, Localize)</span>
                                <span class="hm-live__game">@player.Game</span>
                                <span class="hm-live__since">@T["Live_Since", live.Time(player.Since)]</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (state.Recent.Count > 0)
            {
                <details class="hm-live__recent">
                    <summary>@T["Live_Recent"] <span class="hm-count">@state.Recent.Count</span></summary>
                    <ul class="hm-live__list">
                        @foreach (var session in state.Recent)
                        {
                            <li class="hm-live__item hm-live__item--past">
                                <span class="hm-live__who">@Model.Names.Name(session.UserId, Localize)</span>
                                <span class="hm-live__game">@session.Game</span>
                                <span class="hm-live__since">@live.Time(session.StartedAt) · @T["Live_Minutes", LiveModel.Minutes(session.StartedAt, session.EndedAt ?? live.Now)]</span>
                            </li>
                        }
                    </ul>
                </details>
            }

            @if (live.IsMember)
            {
                <form class="hm-stack hm-stack--sm hm-live__choices" method="post" action="@Model.Url/live" asp-antiforgery="false">
                    @Html.AntiForgeryToken()
                    <h3>@T["Live_YourChoices"]</h3>
                    <div class="hm-checks">
                        <label class="hm-check">
                            <input type="checkbox" name="share" value="true" checked="@state.Share" />
                            <span>@T["Live_Share"]<small>@T["Live_Share_Help"]</small></span>
                        </label>
                        <label class="hm-check">
                            <input type="checkbox" name="notify" value="true" checked="@state.Notify" />
                            <span>@T["Live_Notify"]<small>@T["Live_Notify_Help"]</small></span>
                        </label>
                    </div>
                    @if (!live.SteamVerified)
                    {
                        <p class="hm-help">@T["Live_SteamHint"] <a href="/games/@Model.GuildId">@T["Games_Title"]</a></p>
                    }
                    <div><button class="hm-btn hm-btn--primary">@T["Save"]</button></div>
                </form>
            }
            else
            {
                <p class="hm-help">@T["Live_MembersOnly"]</p>
            }

            @if (state.CanManage)
            {
                <form class="hm-stack hm-stack--sm hm-live__channel" method="post" action="@Model.Url/live/channel" asp-antiforgery="false">
                    @Html.AntiForgeryToken()
                    <h3>@T["Live_Channel"]</h3>
                    <label class="hm-check">
                        <input type="checkbox" name="post" value="true" checked="@state.PostInChannel" />
                        <span>@T["Live_Channel_Post"]<small>@T["Live_Channel_Help"]</small></span>
                    </label>
                    <div><button class="hm-btn">@T["Save"]</button></div>
                </form>
            }
        </section>
    }

    @if (Model.Stats is not null)
    {
        <partial name="_GroupStats" model="Model" />
    }

    @* ---------- Settings (organizer, moderators, administrators) ---------- *@
    @if (manage || Model.Notifications is not null)
    {
        <section class="hm-card hm-section hm-stack hm-group-settings" id="settings" aria-labelledby="settings-title" data-group-panel="settings">
            <div>
                <h2 id="settings-title">@DashboardIcons.Render("settings", cssClass: "hm-heading-icon")@T["Group_settings"]</h2>
                <p class="hm-help">@T["Group_settings_help"]</p>
            </div>
            @if (manage)
            {
                string? error = Model.ErrorFor("settings");
                string value = Model.Form?.Section == "settings" ? Model.Form.Description ?? "" : group.Description ?? "";
                <div class="hm-group-settings__block">
                    <form class="hm-stack hm-stack--sm" method="post" action="@Model.Url/description" asp-antiforgery="false">
                        @Html.AntiForgeryToken()
                        <label class="hm-label hm-group-settings__title" for="description">@T["Description"] <span class="hm-label__opt">@T["Optional"]</span></label>
                        <textarea class="hm-textarea" id="description" name="description" rows="3" maxlength="200"
                                  style="font-family: var(--hm-font); font-size: var(--hm-fs-md)"
                                  aria-invalid="@(error is null ? null : "true")" aria-describedby="description-help @(error is null ? "" : "description-error")">@value</textarea>
                        <p class="hm-help" id="description-help">@T["Up_to_200_characters_Shown_in_the_directory_and_to_invited_members"]</p>
                        @if (error is not null)
                        {
                            <p class="hm-error" id="description-error">@DashboardIcons.Render("alert")@error</p>
                        }
                        <div><button class="hm-btn">@T["Save_description"]</button></div>
                    </form>
                </div>
            }
            @if (manage)
            {
                <form class="hm-group-settings__block" method="post" action="@Model.Url/open" asp-antiforgery="false">
                    @Html.AntiForgeryToken()
                    <h3 class="hm-row" style="gap: var(--hm-space-2)">@DashboardIcons.Render("door", cssClass: "hm-heading-icon")@T["Groups_WhoCanJoin"]</h3>
                    <div class="hm-mode" role="radiogroup" aria-label="@T["Groups_WhoCanJoin"]">
                        <label><input type="radio" name="open" value="false" checked="@(!group.Open)">@T["Groups_InviteOnly"]</label>
                        <label><input type="radio" name="open" value="true" checked="@group.Open">@T["Groups_Open"]</label>
                    </div>
                    <p class="hm-help">@T["Groups_WhoCanJoinHelp"]</p>
                    <div><button class="hm-btn">@T["Save"]</button></div>
                </form>
            }
            @if (manage && Model.Polls is { } tagged)
            {
                var current = tagged.Board.Tags;
                <form class="hm-group-settings__block" method="post" action="@Model.Url/tags" asp-antiforgery="false">
                    @Html.AntiForgeryToken()
                    <h3 class="hm-row" style="gap: var(--hm-space-2)">@DashboardIcons.Render("hash", cssClass: "hm-heading-icon")@T["Group_tags"]</h3>
                    <p class="hm-help">@T["Group_tags_help"]</p>
                    <div class="hm-tag-picker">
                        @foreach (string tag in HappyMix.Application.Polls.GroupTags.BuiltIn)
                        {
                            <label class="hm-tag-picker__item"><input type="checkbox" name="tags" value="@tag" checked="@current.Contains(tag)">
                                <span><b>@T["Tag_" + tag]</b><small>@T["Tag_" + tag + "_help"]</small></span></label>
                        }
                    </div>
                    <div class="hm-field">
                        <label class="hm-label" for="custom-tags">@T["Group_tags_custom"] <span class="hm-label__opt">@T["Optional"]</span></label>
                        <input class="hm-input" id="custom-tags" name="custom" maxlength="200" placeholder="ranked, chill, weekend"
                               value="@string.Join(", ", current.Where(tag => !HappyMix.Application.Polls.GroupTags.IsBuiltIn(tag)))">
                    </div>
                    <div><button class="hm-btn">@T["Group_tags_save"]</button></div>
                </form>
            }
            @if (Model.Notifications is { } notify)
            {
                <div class="hm-group-settings__block hm-group-notify">
                    <div class="hm-row hm-row--between">
                        <h3>@DashboardIcons.Render("bell")@T["Notifications_Settings"]</h3>
                        <span class="hm-badge @(notify.Enabled ? "hm-badge--mint" : "")">@T[notify.Enabled ? "Notifications_On" : "Notifications_Off"]</span>
                    </div>
                    @if (notify.Enabled || notify.Channel is not null)
                    {
                        <dl class="hm-group-notify__facts">
                            <div><dt>@T["Announcement_channel"]</dt><dd>@(notify.Channel ?? "—")</dd></div>
                            <div><dt>@T["Notifications_Language"]</dt><dd>@notify.Language</dd></div>
                            <div><dt>@T["Notifications_LeadTime"]</dt><dd>@T["Arg0_min", notify.LeadMinutes]</dd></div>
                            <div><dt>@T["Notifications_Updates"]</dt><dd>@T[notify.Updates ? "Notifications_On" : "Notifications_Off"]</dd></div>
                        </dl>
                    }
                    else
                    {
                        <p class="hm-help">@T["Group_notifications_off_help"]</p>
                    }
                    <div><a class="hm-btn" href="@notify.Url">@T["Group_notifications_manage"]</a></div>
                </div>
            }
            @if (manage)
            {
            <section class="hm-danger-zone hm-stack" aria-labelledby="close-title">
                <div>
                    <h3 id="close-title">@T["Close_group"]</h3>
                    <p class="hm-help">@T["Deletes_the_group_for_everyone_including_its_Discord_role_Members_invitations_and"]</p>
                </div>
                @if (Model.ErrorFor("close") is { } closeError)
                {
                    <partial name="_Banner" model="ErrorBanner(closeError)" />
                }
                <div><partial name="_Confirm" model="close" /></div>
            </section>
            }
        </section>
    }
</div>

