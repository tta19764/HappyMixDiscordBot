@model AvailabilityPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.IsWeekly ? T["Weekly timetable"] : T["Availability today"];
    ViewData["NavGuildName"] = Model.GuildName;
    string baseUrl = $"/availability/{Model.GuildId}";
    string weeklyUrl = baseUrl + "?view=weekly";
    var nav = new ServerNavModel(Model.GuildId, Model.GuildName, "availability", Model.CanConfigure, "Availability",
        "Tell the group when you can play. HappyMix uses this to plan sessions.");
    var todayRange = new TimeRangeModel("today", T["Today"], Model.Form.Start, Model.Form.End, Model.Form.Offset,
        Model.TimeZone, Model.TimeZoneOffset, Model.Form.AllDay);
}

<partial name="_ServerNav" model="nav" />

<div class="hm-row hm-row--between" style="margin-bottom: var(--hm-space-5)">
    <nav class="hm-segment" aria-label="Availability view">
        <a href="@baseUrl" aria-current="@(Model.IsWeekly ? null : "page")">@DashboardIcons.Render("clock")@T["Today"]</a>
        <a href="@weeklyUrl" aria-current="@(Model.IsWeekly ? "page" : null)">@DashboardIcons.Render("calendar")@T["Weekly timetable"]</a>
    </nav>
    @if (Model.IsWeekly)
    {
        <p class="hm-help" style="display: flex; align-items: center; gap: var(--hm-space-2)">
            @DashboardIcons.Render("globe")<span>Times in <strong style="color: var(--hm-text)">@Model.TimeZone</strong> (server default) unless a day says otherwise</span>
        </p>
    }
</div>

@if (Model.Banner is { } banner)
{
    <div style="margin-bottom: var(--hm-space-4)"><partial name="_Banner" model="banner" /></div>
}

@if (!Model.IsWeekly)
{
    <div class="hm-split">
        <form class="hm-card hm-stack" style="gap: var(--hm-space-5)" method="post" action="@baseUrl" asp-antiforgery="false"
              data-range data-day="@T["Today"]" data-next-day="@T["Tomorrow"]" aria-labelledby="today-title">
            @Html.AntiForgeryToken()
            <div>
                <h2 id="today-title">@T["Today"]</h2>
                <p class="hm-help">@Model.TodayLabel</p>
            </div>

            <partial name="_TimeRange" model="todayRange" />
            <partial name="_Certainty" model="Model.Form.Tentative" />
            <p class="hm-help">@T["Save a range, then add another. Each range has its own certainty."]</p>

            @if (Model.Presets.Count > 0)
            {
                <div class="hm-stack hm-stack--sm" data-presets hidden>
                    <span class="hm-label" id="presets-label">@T["Quick fill"]</span>
                    <div class="hm-row" role="group" aria-labelledby="presets-label" style="gap: var(--hm-space-2)">
                        @foreach (var preset in Model.Presets)
                        {
                            <button class="hm-chip" type="button" aria-pressed="false" data-start="@preset.Start" data-end="@preset.End">@preset.Label <small>@preset.Range</small></button>
                        }
                    </div>
                </div>
            }

            <hr class="hm-divider" style="margin: 0">
            <p class="hm-help">@T["Nothing is shared until you save."]</p>
            <div class="hm-sticky-action" style="display: flex; justify-content: flex-end; margin-top: calc(-1 * var(--hm-space-2))">
                <button class="hm-btn hm-btn--primary hm-btn--lg" name="action" value="today" data-range-save>@DashboardIcons.Render("check")@T["Add range"]</button>
            </div>
        </form>

        <aside class="hm-stack">
            <section class="hm-card" aria-labelledby="upcoming-title">
                <div class="hm-card__head" style="margin-bottom: var(--hm-space-2)">
                    <h2 id="upcoming-title" style="font-size: var(--hm-fs-lg)">@T["Coming up"]</h2>
                    <span class="hm-badge">@T["One-off"]</span>
                </div>
                @if (Model.Upcoming.Count == 0)
                {
                    <div class="hm-empty" style="padding: var(--hm-space-6) var(--hm-space-4)">
                        <p>No one-off windows. Save today's hours and they show up here until they end.</p>
                    </div>
                }
                else
                {
                    <ul class="hm-list">
                        @foreach (var window in Model.Upcoming)
                        {
                            <li class="hm-list__item">
                                <div class="hm-list__main">
                                    <p class="hm-list__title">@window.Title</p>
                                    <p class="hm-list__meta">@window.Meta</p>
                                    <span class="hm-badge @(window.Tentative ? "hm-certainty--tentative" : "hm-certainty--definite")">@T[window.Tentative ? "Tentative" : "Definite"]</span>
                                </div>
                                <form method="post" action="@baseUrl" asp-antiforgery="false">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="windowId" value="@window.Id">
                                    <button class="hm-btn hm-btn--ghost hm-btn--icon" name="action" value="remove" aria-label="Remove @window.Title">@DashboardIcons.Render("trash")</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </section>
            <section class="hm-card hm-stack hm-stack--sm" aria-labelledby="weekly-link-title">
                <h2 id="weekly-link-title" style="font-size: var(--hm-fs-lg)">@T["Weekly timetable"]</h2>
                <p class="hm-help">@Model.WeeklyCount of 7 days set. Weekly hours repeat every week.</p>
                <a class="hm-link-btn" href="@weeklyUrl">Open weekly timetable @DashboardIcons.Render("arrow")</a>
            </section>
        </aside>
    </div>
}
else
{
    <div class="hm-stack">
        <div class="hm-card hm-stack hm-stack--sm">
            <h2>@T["Your usual week"]</h2>
            <p class="hm-help">@T["Save a range, then add another. Each range has its own certainty."]</p>
            <p class="hm-help">@T["The same start time and time zone updates an existing weekly range."] @T["Clear existing ranges before saving a full day."]</p>
        </div>
        @foreach (var row in Model.Week)
        {
            <section class="hm-card hm-stack hm-availability-day" id="@row.Anchor" aria-labelledby="@(row.Anchor)-title">
                <div class="hm-row hm-row--between">
                    <h2 id="@(row.Anchor)-title">@row.Name</h2>
                    @if (row.IsToday) { <span class="hm-badge">@T["Today"]</span> }
                    @if (row.IsSaved) { <span class="hm-badge hm-certainty--definite">@T["✓ Saved"]</span> }
                </div>
                @if (row.Windows.Count == 0)
                {
                    <p class="hm-help">@T["No hours"]</p>
                }
                else
                {
                    <ul class="hm-list">
                        @foreach (var window in row.Windows)
                        {
                            <li class="hm-list__item">
                                <div class="hm-list__main">
                                    <p class="hm-list__title">@(window.IsFullDay ? T["All day"].Value : $"{AvailabilityFormat.Time(window.Start)} → {AvailabilityFormat.Time(window.End)}")
                                        @if (window.End < window.Start) { <span class="hm-muted">· @row.NextShortName</span> }
                                    </p>
                                    <p class="hm-list__meta">@window.TimeZone</p>
                                    <span class="hm-badge @(window.Tentative ? "hm-certainty--tentative" : "hm-certainty--definite")">@T[window.Tentative ? "Tentative" : "Definite"]</span>
                                </div>
                                <form method="post" action="@baseUrl" asp-antiforgery="false">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="day" value="@row.Day">
                                    <input type="hidden" name="start" value="@AvailabilityFormat.Time(window.Start)">
                                    <input type="hidden" name="offset" value="@window.TimeZone">
                                    <button class="hm-btn hm-btn--ghost hm-btn--icon" name="action" value="remove-weekly" aria-label="@T["Remove range"] · @row.Name · @AvailabilityFormat.Time(window.Start)">@DashboardIcons.Render("trash")</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                @if (row.IsEditing)
                {
                    <form class="hm-stack" method="post" action="@baseUrl" asp-antiforgery="false"
                          data-range data-day="@row.ShortName" data-next-day="@row.NextShortName" aria-label="@T["Add range"] · @row.Name">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="day" value="@row.Day">
                        <partial name="_TimeRange" model="new TimeRangeModel(row.Anchor, row.ShortName, Model.Form.Start, Model.Form.End, Model.Form.Offset, Model.TimeZone, Model.TimeZoneOffset, Model.Form.AllDay)" />
                        <partial name="_Certainty" model="Model.Form.Tentative" />
                        <div class="hm-row">
                            <button class="hm-btn hm-btn--primary" name="action" value="weekly" data-range-save>@DashboardIcons.Render("plus")@T["Save range"]</button>
                            <a class="hm-btn hm-btn--ghost" href="@weeklyUrl#@row.Anchor">@T["Cancel"]</a>
                        </div>
                    </form>
                }
                else
                {
                    <div class="hm-row">
                        <a class="hm-btn" href="@weeklyUrl&amp;edit=@row.Day#@row.Anchor">@DashboardIcons.Render("plus")@T["Add range"]</a>
                        @if (row.Windows.Count > 0)
                        {
                            <form method="post" action="@baseUrl" asp-antiforgery="false">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="day" value="@row.Day">
                                <button class="hm-btn hm-btn--danger" name="action" value="clear">@T["Clear day"]</button>
                            </form>
                        }
                    </div>
                }
            </section>
        }
    </div>
}
<datalist id="time-zones">
    @foreach (var zone in HappyMix.Bot.Interactions.AvailabilityTimeZoneAutocomplete.Names)
    {
        <option value="@zone"></option>
    }
</datalist>
