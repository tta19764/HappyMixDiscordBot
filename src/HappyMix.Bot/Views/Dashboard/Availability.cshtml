@model AvailabilityPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.IsWeekly ? T["Weekly_timetable"] : T["Availability_today"];
    ViewData["NavGuildName"] = Model.GuildName;
    string baseUrl = $"/availability/{Model.GuildId}";
    string weeklyUrl = baseUrl + "?view=weekly";
    var nav = new ServerNavModel(Model.GuildId, Model.GuildName, "availability", Model.CanConfigure, "Availability",
        "Tell the group when you can play. HappyMix uses this to plan sessions.");
    var todayRange = new TimeRangeModel("today", T["Today"], Model.Form.Start, Model.Form.End, Model.Form.Offset,
        Model.TimeZone, Model.TimeZoneOffset, Model.Form.AllDay);
}

<partial name="_ServerNav" model="nav" />

<div class="hm-row hm-row--between" style="margin-bottom: var(--hm-space-5)">
    <nav class="hm-segment" aria-label="Availability view">
        <a href="@baseUrl" aria-current="@(Model.IsWeekly ? null : "page")">@DashboardIcons.Render("clock")@T["Today"]</a>
        <a href="@weeklyUrl" aria-current="@(Model.IsWeekly ? "page" : null)">@DashboardIcons.Render("calendar")@T["Weekly_timetable"]</a>
    </nav>
    @if (Model.IsWeekly)
    {
        <p class="hm-help" style="display: flex; align-items: center; gap: var(--hm-space-2)">
            @DashboardIcons.Render("globe")<span>@T["Times_in_Arg0", Model.TimeZone]</span>
        </p>
    }
</div>

@if (Model.Banner is { } banner)
{
    <div style="margin-bottom: var(--hm-space-4)"><partial name="_Banner" model="banner" /></div>
}

@if (Model.MyEvents.Count > 0 || Model.EventInvitations > 0)
{
    ViewData["GuildId"] = Model.GuildId;
    <section class="hm-card hm-my-events" aria-labelledby="my-events-title">
        <div class="hm-card__head">
            <div><h2 id="my-events-title">@T["My_events"]</h2><p>@T["Dates_you_accepted_Pending_plans_may_still_change_confirmed_ones_are_on"]</p></div>
            <a class="hm-btn hm-btn--sm" href="/events/@Model.GuildId">@(Model.EventInvitations > 0 ? T["Arg0_invitations_waiting", Model.EventInvitations] : T["All_events"])</a>
        </div>
        @if (Model.MyEvents.Count == 0)
        {
            <p class="hm-empty-note">@T["Nothing_accepted_yet"]</p>
        }
        else
        {
            <ul class="hm-events">
                @foreach (var row in Model.MyEvents)
                {
                    <partial name="_EventRow" model="row" view-data='new ViewDataDictionary(ViewData) { ["Actions"] = "withdraw", ["ReturnUrl"] = Context.Request.Path + Context.Request.QueryString }' />
                }
            </ul>
        }
    </section>
}

@if (!Model.IsWeekly)
{
    <div class="hm-split">
        <form class="hm-card hm-stack" style="gap: var(--hm-space-5)" method="post" action="@baseUrl" asp-antiforgery="false"
              data-range data-day="@T["Today"]" data-next-day="@T["Tomorrow"]" aria-labelledby="today-title">
            @Html.AntiForgeryToken()
            <div>
                <h2 id="today-title">@T["Today"]</h2>
                <p class="hm-help">@Model.TodayLabel</p>
            </div>

            <partial name="_TimeRange" model="todayRange" />
            <partial name="_Certainty" model="Model.Form.Tentative" />
            <p class="hm-help">@T["Save_a_range_then_add_another_Each_range_has_its_own_certainty"]</p>

            @if (Model.Presets.Count > 0)
            {
                <div class="hm-stack hm-stack--sm" data-presets hidden>
                    <span class="hm-label" id="presets-label">@T["Quick_fill"]</span>
                    <div class="hm-row" role="group" aria-labelledby="presets-label" style="gap: var(--hm-space-2)">
                        @foreach (var preset in Model.Presets)
                        {
                            <button class="hm-chip" type="button" aria-pressed="false" data-start="@preset.Start" data-end="@preset.End">@preset.Label <small>@preset.Range</small></button>
                        }
                    </div>
                </div>
            }

            <hr class="hm-divider" style="margin: 0">
            <p class="hm-help">@T["Nothing_is_shared_until_you_save"]</p>
            <div class="hm-sticky-action" style="display: flex; justify-content: flex-end; margin-top: calc(-1 * var(--hm-space-2))">
                <button class="hm-btn hm-btn--primary hm-btn--lg" name="action" value="today" data-range-save>@DashboardIcons.Render("check")@T["Add_range"]</button>
            </div>
        </form>

        <aside class="hm-stack">
            <section class="hm-card" aria-labelledby="upcoming-title">
                <div class="hm-card__head" style="margin-bottom: var(--hm-space-2)">
                    <h2 id="upcoming-title" style="font-size: var(--hm-fs-lg)">@T["Coming_up"]</h2>
                    <span class="hm-badge">@T["One_off"]</span>
                </div>
                @if (Model.Upcoming.Count == 0)
                {
                    <div class="hm-empty" style="padding: var(--hm-space-6) var(--hm-space-4)">
                        <p>No one-off windows. Save today's hours and they show up here until they end.</p>
                    </div>
                }
                else
                {
                    <ul class="hm-list">
                        @foreach (var window in Model.Upcoming)
                        {
                            <li class="hm-list__item">
                                <div class="hm-list__main">
                                    <p class="hm-list__title">@window.Title</p>
                                    <p class="hm-list__meta">@window.Meta</p>
                                    <span class="hm-badge @(window.Tentative ? "hm-certainty--tentative" : "hm-certainty--definite")">@T.Message(window.Tentative ? "Tentative" : "Definite")</span>
                                </div>
                                <form method="post" action="@baseUrl" asp-antiforgery="false">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="windowId" value="@window.Id">
                                    <button class="hm-btn hm-btn--ghost hm-btn--icon" name="action" value="remove" aria-label="Remove @window.Title">@DashboardIcons.Render("trash")</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </section>
            <section class="hm-card hm-stack hm-stack--sm" aria-labelledby="weekly-link-title">
                <h2 id="weekly-link-title" style="font-size: var(--hm-fs-lg)">@T["Weekly_timetable"]</h2>
                <p class="hm-help">@Model.WeeklyCount of 7 days set. Weekly hours repeat every week.</p>
                <a class="hm-link-btn" href="@weeklyUrl">Open weekly timetable @DashboardIcons.Render("arrow")</a>
            </section>
        </aside>
    </div>
}
else
{
    <section class="hm-card hm-card--flush" aria-labelledby="week-title">
        <div class="hm-card__head" style="padding: var(--hm-space-5) var(--hm-space-5) 0">
            <div>
                <h2 id="week-title">@T["Your_usual_week"]</h2>
                <p>@T["Repeats_every_week_A_day_can_have_several_ranges_each_definite_or"]</p>
            </div>
            <span class="hm-badge hm-tnum">@T["Arg0_of_7_days", Model.WeeklyCount]</span>
        </div>

        <div class="hm-week">
            <div class="hm-week__axis" aria-hidden="true"><span></span><span></span><span class="hm-axis"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></span><span></span></div>
            @for (int index = 0; index < Model.Week.Count; index++)
            {
                var row = Model.Week[index];
                var previous = Model.Week[(index + Model.Week.Count - 1) % Model.Week.Count];
                var carries = previous.Windows.Where(window => !window.IsFullDay && window.End < window.Start).ToArray();
                string editUrl = $"{weeklyUrl}&edit={row.Day}#{row.Anchor}";
                if (row.IsEditing)
                {
                    string editorZone = Model.Form.Offset ?? (row.Windows.Select(window => window.TimeZone).Distinct().Count() == 1
                        ? row.Windows[0].TimeZone : Model.TimeZone);
                    var ranges = Model.Form.Ranges ?? row.Windows.Where(window => window.TimeZone == editorZone)
                        .Select(window => new HappyMix.Application.Guilds.WeeklyRangeInput(AvailabilityFormat.Time(window.Start),
                            AvailabilityFormat.Time(window.End), window.IsFullDay, window.Tentative)).ToArray();
                    var editor = new WeekDayEditorModel(row, ranges, row.Windows.Where(window => window.TimeZone != editorZone).ToArray(),
                        editorZone, Model.TimeZone, Model.TimeZoneOffset, baseUrl, weeklyUrl);
                    <div class="hm-day hm-day--editing" id="@row.Anchor">
                        <span class="hm-day__name">@row.Name<small>@T["Editing"]</small></span>
                        <partial name="_WeekDayEditor" model="editor" />
                    </div>
                    continue;
                }

                <div class="hm-day @(row.IsToday ? "hm-day--today" : "") @(row.IsSaved ? "hm-day--saved" : "")" id="@row.Anchor">
                    <div class="hm-day__label">
                        <span class="hm-day__name">@row.Name
                            @if (row.IsSaved)
                            {
                                <small style="color: var(--hm-mint)">@T["Saved"]</small>
                            }
                            else if (row.IsToday)
                            {
                                <small>@T["Today"]</small>
                            }
                        </span>
                        @if (row.Windows.Count == 0)
                        {
                            <span class="hm-day__none">@T["No_hours"]</span>
                        }
                        else
                        {
                            <span class="hm-day__ranges">
                                @foreach (var window in row.Windows)
                                {
                                    <span class="hm-day__range">
                                        <b>@(window.IsFullDay ? T["All_day"].Value : $"{AvailabilityFormat.Time(window.Start)}–{AvailabilityFormat.Time(window.End)}")</b>
                                        @if (window.End < window.Start)
                                        {
                                            <small>↦ @row.NextShortName</small>
                                        }
                                        <span class="hm-kind @(window.Tentative ? "hm-kind--tentative" : "")">@T.Message(window.Tentative ? "Tentative" : "Definite")</span>
                                        @if (window.TimeZone != Model.TimeZone)
                                        {
                                            <small>@window.TimeZone</small>
                                        }
                                    </span>
                                }
                            </span>
                        }
                    </div>
                    <a class="hm-dayline hm-dayline--link" href="@editUrl" aria-label="@T["Edit_Arg0", row.Name]">
                        @foreach (var carry in carries)
                        {
                            <span class="hm-dayline__seg hm-dayline__seg--carry @(carry.Tentative ? "hm-dayline__seg--tentative" : "")" style="left: 0; width: @AvailabilityFormat.Css(AvailabilityFormat.Percent(carry.End))"></span>
                        }
                        @foreach (var window in row.Windows)
                        {
                            double left = window.IsFullDay ? 0 : AvailabilityFormat.Percent(window.Start);
                            double width = (window.IsFullDay || window.End < window.Start ? 100 : AvailabilityFormat.Percent(window.End)) - left;
                            <span class="hm-dayline__seg @(window.End < window.Start ? "hm-dayline__seg--overnight" : "") @(window.Tentative ? "hm-dayline__seg--tentative" : "")"
                                  style="left: @AvailabilityFormat.Css(left); width: @AvailabilityFormat.Css(width)"></span>
                        }
                    </a>
                    <div class="hm-day__actions">
                        <a class="hm-btn" href="@editUrl" aria-label="@T["Edit_Arg0", row.Name]">@DashboardIcons.Render(row.Windows.Count == 0 ? "plus" : "pencil")<span class="hm-btn__label">@T.Message(row.Windows.Count == 0 ? "Add hours" : "Edit")</span></a>
                        @if (row.Windows.Count > 0)
                        {
                            var clear = new ConfirmModel(T["Clear"], T["Remove_every_weekly_range_on_Arg0", row.Name], baseUrl, T["Clear_Arg0", row.Name],
                                Fields: new Dictionary<string, string> { ["action"] = "clear", ["day"] = row.Day.ToString() }, TriggerLabel: T["Clear_Arg0", row.Name]);
                            <partial name="_Confirm" model="clear" />
                        }
                    </div>
                </div>
            }
        </div>
        <div class="hm-row hm-week__legend">
            <span class="hm-row" style="gap: var(--hm-space-2)"><span class="hm-dayline__seg hm-legend-swatch"></span>@T["Definite"]</span>
            <span class="hm-row" style="gap: var(--hm-space-2)"><span class="hm-dayline__seg hm-dayline__seg--tentative hm-legend-swatch"></span>@T["Tentative"]</span>
            <span class="hm-row" style="gap: var(--hm-space-2)"><span class="hm-dayline__seg hm-dayline__seg--carry hm-legend-swatch"></span>@T["Carried_over_from_the_night_before"]</span>
        </div>
    </section>
}

<datalist id="time-zones">
    @foreach (var zone in HappyMix.Bot.Interactions.AvailabilityTimeZoneAutocomplete.Names)
    {
        <option value="@zone"></option>
    }
</datalist>
