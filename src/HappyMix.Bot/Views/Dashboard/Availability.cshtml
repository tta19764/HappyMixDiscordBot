@model AvailabilityPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.IsWeekly ? T["Weekly timetable"] : T["Availability today"];
    ViewData["NavGuildName"] = Model.GuildName;
    string baseUrl = $"/availability/{Model.GuildId}";
    string weeklyUrl = baseUrl + "?view=weekly";
    var nav = new ServerNavModel(Model.GuildId, Model.GuildName, "availability", Model.CanConfigure, "Availability",
        "Tell the group when you can play. HappyMix uses this to plan sessions.");
    var todayRange = new TimeRangeModel("today", T["Today"], Model.Form.Start, Model.Form.End, Model.Form.Offset,
        Model.TimeZone, Model.TimeZoneOffset);
}

<partial name="_ServerNav" model="nav" />

<div class="hm-row hm-row--between" style="margin-bottom: var(--hm-space-5)">
    <nav class="hm-segment" aria-label="Availability view">
        <a href="@baseUrl" aria-current="@(Model.IsWeekly ? null : "page")">@DashboardIcons.Render("clock")@T["Today"]</a>
        <a href="@weeklyUrl" aria-current="@(Model.IsWeekly ? "page" : null)">@DashboardIcons.Render("calendar")@T["Weekly timetable"]</a>
    </nav>
    @if (Model.IsWeekly)
    {
        <p class="hm-help" style="display: flex; align-items: center; gap: var(--hm-space-2)">
            @DashboardIcons.Render("globe")<span>Times in <strong style="color: var(--hm-text)">@Model.TimeZone</strong> (server default) unless a day says otherwise</span>
        </p>
    }
</div>

@if (Model.Banner is { } banner)
{
    <div style="margin-bottom: var(--hm-space-4)"><partial name="_Banner" model="banner" /></div>
}

@if (!Model.IsWeekly)
{
    <div class="hm-split">
        <form class="hm-card hm-stack" style="gap: var(--hm-space-5)" method="post" action="@baseUrl" asp-antiforgery="false"
              data-range data-day="@T["Today"]" data-next-day="@T["Tomorrow"]" aria-labelledby="today-title">
            @Html.AntiForgeryToken()
            <div>
                <h2 id="today-title">@T["Today"]</h2>
                <p class="hm-help">@Model.TodayLabel</p>
            </div>

            <partial name="_TimeRange" model="todayRange" />

            @if (Model.Presets.Count > 0)
            {
                <div class="hm-stack hm-stack--sm" data-presets hidden>
                    <span class="hm-label" id="presets-label">@T["Quick fill"]</span>
                    <div class="hm-row" role="group" aria-labelledby="presets-label" style="gap: var(--hm-space-2)">
                        @foreach (var preset in Model.Presets)
                        {
                            <button class="hm-chip" type="button" aria-pressed="false" data-start="@preset.Start" data-end="@preset.End">@preset.Label <small>@preset.Range</small></button>
                        }
                    </div>
                </div>
            }

            <hr class="hm-divider" style="margin: 0">
            <p class="hm-help">@T["Nothing is shared until you save."]</p>
            <div class="hm-sticky-action" style="display: flex; justify-content: flex-end; margin-top: calc(-1 * var(--hm-space-2))">
                <button class="hm-btn hm-btn--primary hm-btn--lg" name="action" value="today" data-range-save>@DashboardIcons.Render("check")@T["Save today"]</button>
            </div>
        </form>

        <aside class="hm-stack">
            <section class="hm-card" aria-labelledby="upcoming-title">
                <div class="hm-card__head" style="margin-bottom: var(--hm-space-2)">
                    <h2 id="upcoming-title" style="font-size: var(--hm-fs-lg)">@T["Coming up"]</h2>
                    <span class="hm-badge">@T["One-off"]</span>
                </div>
                @if (Model.Upcoming.Count == 0)
                {
                    <div class="hm-empty" style="padding: var(--hm-space-6) var(--hm-space-4)">
                        <p>No one-off windows. Save today's hours and they show up here until they end.</p>
                    </div>
                }
                else
                {
                    <ul class="hm-list">
                        @foreach (var window in Model.Upcoming)
                        {
                            <li class="hm-list__item">
                                <div class="hm-list__main">
                                    <p class="hm-list__title">@window.Title</p>
                                    <p class="hm-list__meta">@window.Meta</p>
                                </div>
                                <form method="post" action="@baseUrl" asp-antiforgery="false">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="windowId" value="@window.Id">
                                    <button class="hm-btn hm-btn--ghost hm-btn--icon" name="action" value="remove" aria-label="Remove @window.Title">@DashboardIcons.Render("trash")</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </section>
            <section class="hm-card hm-stack hm-stack--sm" aria-labelledby="weekly-link-title">
                <h2 id="weekly-link-title" style="font-size: var(--hm-fs-lg)">@T["Weekly timetable"]</h2>
                <p class="hm-help">@Model.WeeklyCount of 7 days set. Weekly hours repeat every week.</p>
                <a class="hm-link-btn" href="@weeklyUrl">Open weekly timetable @DashboardIcons.Render("arrow")</a>
            </section>
        </aside>
    </div>
}
else if (Model.WeeklyCount == 0 && !Model.IsEditing)
{
    <section class="hm-card">
        <div class="hm-empty">
            <span class="hm-empty__icon">@DashboardIcons.Render("calendar", "width: 1.5rem; height: 1.5rem")</span>
            <h2>@T["No weekly hours yet"]</h2>
            <p>Add the evenings you usually play once. HappyMix repeats them every week.</p>
            <a class="hm-btn hm-btn--primary" href="@weeklyUrl&amp;edit=Monday#monday">@DashboardIcons.Render("plus")Add Monday hours</a>
        </div>
    </section>
}
else
{
    <section class="hm-card hm-card--flush" aria-labelledby="week-title">
        <div class="hm-card__head" style="padding: var(--hm-space-5) var(--hm-space-5) 0">
            <div>
                <h2 id="week-title">@T["Your usual week"]</h2>
                <p>@T["Repeats every week until you clear a day."]</p>
            </div>
            <span class="hm-badge hm-tnum">@Model.WeeklyCount of 7 days</span>
        </div>
        <div class="hm-week__axis" aria-hidden="true"><span></span><span></span><span class="hm-axis"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></span><span></span></div>

        <div class="hm-week">
            @foreach (var row in Model.Week)
            {
                string editUrl = $"{weeklyUrl}&edit={row.Name}#{row.Anchor}";
                if (row.IsEditing)
                {
                    <div class="hm-day hm-day--editing" id="@row.Anchor">
                        <span class="hm-day__name" style="padding-top: 1.9rem">@row.Name<small>@(row.Window is null ? "Adding hours" : "Editing")</small></span>
                        <form class="hm-day__editor" method="post" action="@baseUrl" asp-antiforgery="false"
                              data-range data-day="@row.ShortName" data-next-day="@row.NextShortName" aria-label="Edit @row.Name hours">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="day" value="@row.Day">
                            <partial name="_TimeRange" model="new TimeRangeModel(row.Anchor, row.ShortName, Model.Form.Start, Model.Form.End, Model.Form.Offset, Model.TimeZone, Model.TimeZoneOffset)" />
                            <div class="hm-row" style="justify-content: flex-end">
                                <a class="hm-btn hm-btn--ghost" href="@weeklyUrl#@row.Anchor">@T["Cancel"]</a>
                                <button class="hm-btn hm-btn--primary" name="action" value="weekly" data-range-save>@DashboardIcons.Render("check")Save @row.Name</button>
                            </div>
                        </form>
                    </div>
                    continue;
                }

                string label = row.Window is { } w
                    ? $"{AvailabilityFormat.Time(w.Start)} to {AvailabilityFormat.Time(w.End)}{(row.Overnight ? " " + row.NextShortName : "")}"
                    : "No hours";
                if (row.CarryPercent is not null)
                    label = "Carried over from the night before, then " + label;
                <div class="hm-day @(row.IsToday ? "hm-day--today" : "") @(row.IsSaved ? "hm-day--saved" : "")" id="@row.Anchor">
                    <div class="hm-day__label">
                        <span class="hm-day__name">@row.Name
                            @if (row.IsSaved)
                            {
                                <small style="color: var(--hm-mint)">@T["✓ Saved"]</small>
                            }
                            else if (row.IsToday)
                            {
                                <small>@T["Today"]</small>
                            }
                        </span>
                        @if (row.Window is { } window)
                        {
                            <span class="hm-day__time">@AvailabilityFormat.Time(window.Start) → @AvailabilityFormat.Time(window.End)<small style="@(row.Overnight ? "color: var(--hm-mint)" : null)">@(row.Overnight ? $"Overnight · into {row.NextShortName}" : row.Duration)@(row.ZoneNote is { } zone ? " · " + zone : "")</small></span>
                        }
                        else
                        {
                            <span class="hm-day__none">@T["No hours"]</span>
                        }
                    </div>
                    <div class="hm-dayline" role="img" aria-label="@row.Name: @label">
                        @if (row.CarryPercent is { } carry)
                        {
                            <span class="hm-dayline__seg hm-dayline__seg--carry" style="left: 0; width: @AvailabilityFormat.Css(carry)"></span>
                        }
                        @if (row.Window is not null)
                        {
                            <span class="hm-dayline__seg @(row.Overnight ? "hm-dayline__seg--overnight" : "")" style="left: @AvailabilityFormat.Css(row.Left); width: @AvailabilityFormat.Css(row.Width)"></span>
                        }
                    </div>
                    <div class="hm-day__actions">
                        @if (row.Window is not null)
                        {
                            <a class="hm-btn" href="@editUrl" aria-label="Edit @row.Name hours">@DashboardIcons.Render("pencil")<span class="hm-btn__label">@T["Edit"]</span></a>
                            <form method="post" action="@baseUrl" asp-antiforgery="false">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="day" value="@row.Day">
                                <button class="hm-btn hm-btn--danger" name="action" value="clear" aria-label="Clear @row.Name hours">@DashboardIcons.Render("trash")<span class="hm-btn__label">@T["Clear"]</span></button>
                            </form>
                        }
                        else
                        {
                            <a class="hm-btn" href="@editUrl" aria-label="Add @row.Name hours">@DashboardIcons.Render("plus")<span class="hm-btn__label">@T["Add hours"]</span></a>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="hm-row" style="gap: var(--hm-space-5); padding: var(--hm-space-3) var(--hm-space-5); border-top: 1px solid var(--hm-border); font-size: var(--hm-fs-xs); color: var(--hm-text-subtle)">
            <span class="hm-row" style="gap: var(--hm-space-2)"><span class="hm-dayline__seg" style="position: static; display: inline-block; width: 1.75rem; height: .625rem"></span>@T["Available"]</span>
            <span class="hm-row" style="gap: var(--hm-space-2)"><span class="hm-dayline__seg hm-dayline__seg--carry" style="position: static; display: inline-block; width: 1.75rem; height: .625rem; border-radius: 999px"></span>@T["Carried over from the night before"]</span>
        </div>
    </section>
}

<datalist id="time-zones">
    @foreach (var zone in HappyMix.Bot.Interactions.AvailabilityTimeZoneAutocomplete.Names)
    {
        <option value="@zone"></option>
    }
</datalist>
