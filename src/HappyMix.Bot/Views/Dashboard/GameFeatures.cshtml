@model GamesPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = T["Features_Title"];
    var nav = new ServerNavModel(Model.GuildId, Model.GuildName, "game-features", Model.IsAdmin, "Features_Title", T["Features_Lead"]);
    string url = $"/game-features/{Model.GuildId}";
    string ViewUrl(string view) => url + "?view=" + view + (Model.Query is { } query ? "&q=" + Uri.EscapeDataString(query) : "");
    var views = new[] { ("cards", "overview", T["Features_ViewCards"].Value), ("table", "logs", T["Features_ViewTable"].Value), ("list", "menu", T["Features_ViewList"].Value) };
}
<partial name="_ServerNav" model="nav" />
@if (Model.Banner is { } banner)
{
    <div style="margin-bottom: var(--hm-space-4)"><partial name="_Banner" model="banner" /></div>
}

<section class="hm-card hm-stack" aria-labelledby="games-title">
    <div class="hm-games-toolbar">
        <h2 id="games-title">@T["Features_Games"] <span class="hm-count">@Model.Games.Count</span></h2>
        <form class="hm-row hm-games-toolbar__search" method="get" action="@url" role="search">
            <input type="hidden" name="view" value="@Model.View">
            <input class="hm-input" type="search" name="q" value="@Model.Query" placeholder="@T["Features_SearchGames"]" aria-label="@T["Features_SearchGames"]"
                   data-game-filter>
            <button class="hm-btn">@DashboardIcons.Render("search")@T["Search"]</button>
        </form>
        <nav class="hm-segment hm-segment--compact" aria-label="@T["Features_View"]">
            @foreach (var (key, icon, label) in views)
            {
                <a href="@ViewUrl(key)" aria-current="@(Model.View == key ? "page" : null)" title="@label">@DashboardIcons.Render(icon)<span>@label</span></a>
            }
        </nav>
    </div>

    @if (Model.Games.Count == 0)
    {
        <p class="hm-empty-note">@T["Features_NoGames"]</p>
    }
    else if (Model.View == "table")
    {
        <div class="hm-games-tablewrap">
            <table class="hm-games-table">
                <thead>
                    <tr><th scope="col">@T["Features_Game"]</th><th scope="col">@T["Features_Available"]</th><th scope="col">@T["Features_Status"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var card in Model.Games)
                    {
                        <tr data-game-name="@card.Game.Name.ToLowerInvariant()">
                            <td>
                                <a class="hm-games-table__game" href="@url/@card.Game.Key">
                                    <img src="@card.Game.Art" alt="" width="92" height="43" loading="lazy" data-game-art
                                         data-art-fallback="@HappyMix.Bot.Services.SteamArt.Fallback(card.Game.AppId)">
                                    <b>@card.Game.Name</b>
                                </a>
                            </td>
                            <td><partial name="_GameFeatureChips" model="card.Game" /></td>
                            <td class="hm-subtle">@string.Join(" · ", card.Status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <ul class="@(Model.View == "list" ? "hm-games-list" : "hm-games-grid")">
            @foreach (var card in Model.Games)
            {
                <li data-game-name="@card.Game.Name.ToLowerInvariant()">
                    <a class="hm-gamecard" href="@url/@card.Game.Key">
                        <span class="hm-gamecard__art">
                            <img src="@card.Game.Art" alt="" width="460" height="215" loading="lazy" data-game-art
                                 data-art-fallback="@HappyMix.Bot.Services.SteamArt.Fallback(card.Game.AppId)">
                        </span>
                        <span class="hm-gamecard__body">
                            <b class="hm-gamecard__name">@card.Game.Name</b>
                            <partial name="_GameFeatureChips" model="card.Game" />
                            <span class="hm-gamecard__status">@string.Join(" · ", card.Status)</span>
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
    <p class="hm-help">@T["Features_ListHelp"]</p>
</section>
