@using HappyMix.Application.Guilds
@model ApproveLinkPage
@{
    bool admin = ViewData["AdminMode"] is true;
    Layout = admin ? null : "_DashboardLayout";
    ViewData["Title"] = T["Approve_linked_account"];
    SideNav.Set(ViewData, Model.GuildId, Model.GuildName, "links", Model.Viewer.CanConfigure);
    string Localize(string key) => T.Message(key);
    BannerModel ErrorBanner(string message) => new("error", message, null, true);
    var preview = Model.Preview;
    string Day(DayOfWeek day) => System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(day);
}

@if (!admin)
{
<nav class="hm-crumbs" aria-label="@T["Breadcrumb"]">
    <a href="/">@T["Servers"]</a><span aria-hidden="true">/</span>
    <a href="/links/@Model.GuildId">@T["Linked_accounts"]</a><span aria-hidden="true">/</span>
    <span>@T["Approve"]</span>
</nav>
}

@if (preview is null)
{
    <section class="hm-card hm-forbidden" style="margin-top: var(--hm-space-6)">
        <div class="hm-empty" style="border: 0">
            <span class="hm-empty__icon">@DashboardIcons.Render("shield", "width: 1.5rem; height: 1.5rem")</span>
            @if (Model.SameAccount)
            {
                <h1 style="font-size: var(--hm-fs-xl)">@T["Switch_to_your_alternate_account"]</h1>
                <p>@Model.Error</p>
                <p>@T["Copy_this_page_s_address_sign_out_sign_in_to_Discord_as"]</p>
                <form action="/logout" method="post" asp-antiforgery="false">
                    @Html.AntiForgeryToken()
                    <button class="hm-btn hm-btn--primary">@T["Sign_out"]</button>
                </form>
            }
            else
            {
                <h1 style="font-size: var(--hm-fs-xl)">@T["Can_t_use_this_link"]</h1>
                <p>@Model.Error</p>
                <a class="hm-btn" href="/links/@Model.GuildId">@T["Back_to_linked_accounts"]</a>
            }
        </div>
    </section>
}
else
{
    var primary = Model.Names.Get(preview.PrimaryId);
    string primaryName = Model.Names.Name(preview.PrimaryId, Localize);
    var alternate = Model.Names.Get(preview.AlternateId);
    string alternateName = Model.Names.Name(preview.AlternateId, Localize);
    bool hasConflicts = preview.WeeklyConflicts.Length + preview.WindowConflicts.Length > 0;

    <div class="hm-page-head">
        <div>
            <h1>@T["Link_Arg0_to_Arg1", alternateName, primaryName]</h1>
            <p>@if (admin) { @T["This_links_both_accounts_in_the_selected_server"] } else { @T["You_re_signed_in_as_Arg0_Approving_makes_this_account_an_alternate", alternateName, primaryName, Model.GuildName] }</p>
        </div>
    </div>

    <form class="hm-stack" style="gap: var(--hm-space-5); max-width: 52rem" method="post" action="@(admin ? $"/links/{Model.GuildId}/admin" : $"/links/{Model.GuildId}/approve/{Model.RequestId}")" asp-antiforgery="false">
        @Html.AntiForgeryToken()
        @if (admin)
        {
            <input type="hidden" name="primary" value="@preview.PrimaryId">
            <input type="hidden" name="alternate" value="@preview.AlternateId">
        }
        else
        {
            <input type="hidden" name="token" value="@Model.Token">
        }

        @if (Model.Error is { } error)
        {
            <partial name="_Banner" model="ErrorBanner(error)" />
        }

        <section class="hm-card hm-stack" aria-labelledby="who-title">
            <h2 id="who-title" style="font-size: var(--hm-fs-lg)">@T["Accounts"]</h2>
            <div class="hm-link-pair">
                <span class="hm-link-pair__who"><partial name="_Avatar" model="new AvatarModel(primary, primaryName)" /><span><b>@primaryName</b><small>@T["Primary"]</small></span></span>
                <span aria-hidden="true">@DashboardIcons.Render("arrow")</span>
                <span class="hm-link-pair__who"><partial name="_Avatar" model="new AvatarModel(alternate, alternateName)" /><span><b>@alternateName</b><small>@T["Alternate_twink"] @if (!admin) { <text> · @T["You"]</text> }</small></span></span>
            </div>
            <p class="hm-help"><strong>@T["Discord_permissions_are_never_shared"]</strong> @T["Admin_and_moderator_access_still_depends_on_the_account_you_sign_in"]</p>
        </section>

        <section class="hm-card hm-stack" aria-labelledby="groups-title">
            <h2 id="groups-title" style="font-size: var(--hm-fs-lg)">@T["Groups"]</h2>
            <dl class="hm-impact">
                <dt>@T["Shared_from_now_on"]</dt>
                <dd>@(string.Join(", ", preview.GroupsFromPrimary.Concat(preview.GroupsFromAlternate).Concat(preview.SharedGroups)) is { Length: > 0 } all ? all : T["None"].Value)</dd>
                <dt>@T["Already_in_with_both_accounts_counted_once"]</dt>
                <dd>@(preview.SharedGroups.Length > 0 ? string.Join(", ", preview.SharedGroups) : T["None"].Value)</dd>
                <dt>@T["Duplicate_invitations_merged"]</dt>
                <dd>@(preview.MergedInvitations.Length > 0 ? string.Join(", ", preview.MergedInvitations) : T["None"].Value)</dd>
            </dl>
            @if (preview.OrganizedByAlternate.Length > 0)
            {
                <label class="hm-check" style="align-items: flex-start; padding: var(--hm-space-3); border: 1px solid var(--hm-border-strong)">
                    <input type="checkbox" name="acknowledge" value="true" required>
                    <span>@T["I_understand_Arg0_will_share_organizer_rights_for_Arg1", primaryName, string.Join(", ", preview.OrganizedByAlternate)]<small>@T["The_groups_stay_saved_under_this_account_and_remain_yours_if_you"]</small></span>
                </label>
            }
        </section>

        <section class="hm-card hm-stack" aria-labelledby="schedule-title">
            <h2 id="schedule-title" style="font-size: var(--hm-fs-lg)">@T["Schedule"]</h2>
            <p class="hm-help">@T["Both_accounts_will_use_one_schedule_Moving_Arg0_one_off_windows_and", preview.WindowsMoved, preview.WeeklyDaysMoved, preview.DuplicatesMerged]</p>
            @if (hasConflicts)
            {
                <p class="hm-help"><strong>@T["These_entries_overlap_Choose_which_to_keep_for_each_one"]</strong></p>
                @foreach (var conflict in preview.WeeklyConflicts)
                {
                    <fieldset class="hm-choice">
                        <legend>@T["Every_Arg0", Day(conflict.Day)]</legend>
                        <label><input type="radio" name="weekly-@conflict.Day" value="primary" required> @T["Keep_Arg0_s", primaryName] <b>@string.Join(", ", conflict.Primary.Select(window => MemberStacks.Weekly(window, Localize)))</b></label>
                        <label><input type="radio" name="weekly-@conflict.Day" value="alternate"> @T["Keep_Arg0_s", alternateName] <b>@string.Join(", ", conflict.Alternate.Select(window => MemberStacks.Weekly(window, Localize)))</b></label>
                    </fieldset>
                }
                @foreach (var conflict in preview.WindowConflicts)
                {
                    <fieldset class="hm-choice">
                        <legend>@MemberStacks.Window(conflict.Alternate, Model.TimeZone, Localize)</legend>
                        <label><input type="radio" name="window-@conflict.Alternate.Id" value="primary" required> @T["Keep_Arg0_s", primaryName] <b>@string.Join(", ", conflict.Primary.Select(window => MemberStacks.Window(window, Model.TimeZone, Localize)))</b></label>
                        <label><input type="radio" name="window-@conflict.Alternate.Id" value="alternate"> @T["Keep_Arg0_s", alternateName] <b>@MemberStacks.Window(conflict.Alternate, Model.TimeZone, Localize)</b></label>
                    </fieldset>
                }
            }
            <p class="hm-help">@T["Nothing_is_thrown_away_this_account_s_current_schedule_is_saved_and"]</p>
        </section>

        <div class="hm-row hm-sticky-action" style="justify-content: flex-end">
            <a class="hm-btn hm-btn--ghost" href="@(admin ? $"/links/{Model.GuildId}/admin" : $"/links/{Model.GuildId}")">@T["Cancel"]</a>
            <button class="hm-btn hm-btn--primary hm-btn--lg">@T["Approve_link"]</button>
        </div>
    </form>
}
