@model ServerSettingsForm
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = T["Server settings"];
    var settingsPage = (SettingsPage)ViewData["Settings"]!;
    ViewData["NavGuildName"] = settingsPage.GuildName;
    var state = ViewData.ModelState;
    var nav = new ServerNavModel(settingsPage.GuildId, settingsPage.GuildName, "settings", true, "Server settings",
        T["Where and when HappyMix posts esports announcements. Only server administrators see this page."]);

    var labels = new Dictionary<string, string>
    {
        ["ChannelId"] = $"{T["Server defaults"]} · {T["Announcement channel"]}",
        ["TimeZone"] = $"{T["Server defaults"]} · {T["Time zone"]}",
        ["ReminderMinutes"] = $"{T["Server defaults"]} · {T["Reminder lead time"]}",
        ["OrganizerRoles"] = $"{T["Server defaults"]} · {T["Organizer roles"]}",
    };
    foreach (var (prefix, game) in new[] { ("Cs", "Counter-Strike 2"), ("Dota", "Dota 2") })
    {
        labels[$"{prefix}.Channel"] = $"{game} · {T["Announcement channel"]}";
        labels[$"{prefix}.PingRole"] = $"{game} · {T["Reminder ping role"]}";
        labels[$"{prefix}.Teams"] = $"{game} · {T["Followed teams"]}";
        labels[$"{prefix}.Twitch"] = $"{game} · {T["Twitch channels"]}";
        labels[$"{prefix}.Catalog"] = $"{game} · {T["Team aliases"]}";
    }

    var fieldErrors = state.Where(entry => entry.Key.Length > 0 && entry.Value?.Errors.Count > 0).Select(entry => entry.Key).ToArray();
    var generalErrors = state.TryGetValue("", out var general) ? general.Errors.Select(error => error.ErrorMessage).ToArray() : Array.Empty<string>();
    int csErrors = fieldErrors.Count(key => key.StartsWith("Cs.", StringComparison.Ordinal));
    int dotaErrors = fieldErrors.Count(key => key.StartsWith("Dota.", StringComparison.Ordinal));
    int defaultErrors = fieldErrors.Length - csErrors - dotaErrors;
    bool failed = fieldErrors.Length > 0 || generalErrors.Length > 0;

    BannerModel? banner = settingsPage.Banner;
    if (failed)
    {
        string title = fieldErrors.Length switch
        {
            0 => T["Settings not saved"].Value,
            1 => T["Settings not saved: 1 field needs attention"].Value,
            var count => T["Settings not saved: {0} fields need attention", count].Value
        };
        banner = new BannerModel("error", title, generalErrors.Length > 0 ? string.Join(" ", generalErrors) : null, true,
            fieldErrors.Select(key => (labels.GetValueOrDefault(key, key), "#" + FormErrors.Id(key) + (key.EndsWith(".Catalog") ? "-details" : ""))).ToList());
    }

    var csData = new ViewDataDictionary(ViewData) { ["GameTitle"] = "Counter-Strike 2", ["GameMark"] = "CS2", ["GameDefaults"] = settingsPage.CounterStrike, ["SectionId"] = "cs2" };
    var dotaData = new ViewDataDictionary(ViewData) { ["GameTitle"] = "Dota 2", ["GameMark"] = "D2", ["GameDefaults"] = settingsPage.Dota, ["SectionId"] = "dota2" };
}

<partial name="_ServerNav" model="nav" />

<form method="post" action="/settings/@settingsPage.GuildId" asp-antiforgery="false" data-track-changes data-dirty="@(failed ? "true" : "false")">
    @Html.AntiForgeryToken()
    <div class="hm-split hm-split--nav">
        <nav class="hm-sidenav" aria-label="@T["Settings sections"]">
            <a href="#defaults">@T["Server defaults"]
                @if (defaultErrors > 0)
                {
                    <span class="hm-badge hm-badge--danger" aria-label="@T["{0} to fix", defaultErrors]">@defaultErrors</span>
                }
            </a>
            <a href="#cs2">Counter-Strike 2
                @if (csErrors > 0)
                {
                    <span class="hm-badge hm-badge--danger" aria-label="@T["{0} to fix", csErrors]">@csErrors</span>
                }
            </a>
            <a href="#dota2">Dota 2
                @if (dotaErrors > 0)
                {
                    <span class="hm-badge hm-badge--danger" aria-label="@T["{0} to fix", dotaErrors]">@dotaErrors</span>
                }
            </a>
            <p class="hm-help" style="padding: var(--hm-space-3) var(--hm-space-3) 0; font-size: var(--hm-fs-xs)">@T["Game sections inherit from Server defaults unless you override a value."]</p>
        </nav>

        <div class="hm-stack" style="gap: var(--hm-space-6); min-width: 0">
            @if (banner is not null)
            {
                <partial name="_Banner" model="banner" />
            }
            @if (settingsPage.Channels.Length == 0)
            {
                <div class="hm-banner hm-banner--warn">
                    <span class="hm-banner__icon">@DashboardIcons.Render("bang")</span>
                    <div class="hm-banner__body">
                        <p class="hm-banner__title">@T["HappyMix can't post in any text channel yet"]</p>
                        <p class="hm-banner__text">@T["In Discord, give the HappyMix role View Channel, Send Messages and Embed Links in at least one standard text channel, then reload this page."]</p>
                    </div>
                </div>
            }

            <section class="hm-card hm-section" id="defaults" aria-labelledby="defaults-title">
                <div class="hm-section__head">
                    <span class="hm-game-mark" aria-hidden="true">@DashboardIcons.Render("sliders")</span>
                    <div><h2 id="defaults-title">@T["Server defaults"]</h2><p>@T["Used by every game unless the game overrides it."]</p></div>
                </div>
                <div class="hm-fields">
                    <div class="hm-field">
                        <label class="hm-label" asp-for="ChannelId">@T["Announcement channel"]</label>
                        <select class="hm-select" asp-for="ChannelId" asp-items="settingsPage.Channels" data-picker
                                data-picker-search="@T["Find a channel"]" data-picker-empty="@T["No channels match."]"
                                aria-invalid="@FormErrors.Invalid(state, "ChannelId")" aria-describedby="@FormErrors.DescribedBy(state, "ChannelId", "ChannelId-help")">
                            <option value="0">@T["Bot default · {0}", settingsPage.DeploymentChannel]</option>
                        </select>
                        <p class="hm-help" id="ChannelId-help">@T["Text channels where HappyMix can view, send messages and embed links."]</p>
                        @FormErrors.Render(state, "ChannelId")
                    </div>
                    <div class="hm-field">
                        <label class="hm-label" asp-for="TimeZone">@T["Time zone"]</label>
                        <input class="hm-input" asp-for="TimeZone" list="time-zones" autocomplete="off" spellcheck="false" placeholder="Europe/Kyiv"
                               aria-invalid="@FormErrors.Invalid(state, "TimeZone")" aria-describedby="@FormErrors.DescribedBy(state, "TimeZone", "TimeZone-help")">
                        <p class="hm-help" id="TimeZone-help">@T["Used for schedules and availability. Start typing a city, like Kyiv, or enter UTC."]</p>
                        @FormErrors.Render(state, "TimeZone")
                    </div>
                    <div class="hm-field">
                        <label class="hm-label" asp-for="ReminderMinutes">@T["Reminder lead time"]</label>
                        <div class="hm-affix" style="max-width: 14rem">
                            <input class="hm-input hm-tnum" asp-for="ReminderMinutes" min="1" max="1440" inputmode="numeric"
                                   aria-invalid="@FormErrors.Invalid(state, "ReminderMinutes")" aria-describedby="@FormErrors.DescribedBy(state, "ReminderMinutes", "ReminderMinutes-help")">
                            <span class="hm-affix__text">@T["minutes"]</span>
                        </div>
                        <p class="hm-help" id="ReminderMinutes-help">@T["Before a followed match. 1–1440."]</p>
                        @FormErrors.Render(state, "ReminderMinutes")
                    </div>
                    <fieldset class="hm-field" id="OrganizerRoles" style="border: 0; padding: 0; margin: 0"
                              aria-describedby="@FormErrors.DescribedBy(state, "OrganizerRoles", "OrganizerRoles-help")">
                        <legend class="hm-label" style="margin-bottom: var(--hm-space-2)">@T["Organizer roles"] <span class="hm-label__opt">@T["optional"]</span></legend>
                        @if (settingsPage.Roles.Length == 0)
                        {
                            <p class="hm-help">@T["This server has no roles yet."]</p>
                        }
                        else
                        {
                            <div class="hm-checkbox-box">
                                @foreach (var role in settingsPage.Roles)
                                {
                                    <label class="hm-check"><input type="checkbox" name="OrganizerRoles" value="@role.Id" checked="@Model.OrganizerRoles.Contains(role.Id)"><span class="hm-role-dot" style="background: @role.Color"></span>@role.Name</label>
                                }
                            </div>
                        }
                        <p class="hm-help" id="OrganizerRoles-help" style="margin-top: var(--hm-space-2)">@T["With none selected, any member can organize a group."]</p>
                        @FormErrors.Render(state, "OrganizerRoles")
                    </fieldset>
                    <fieldset class="hm-field hm-field--wide" style="border: 0; padding: 0; margin: 0">
                        <legend class="hm-label" style="margin-bottom: var(--hm-space-2)">@T["Post to the channel"]</legend>
                        <div class="hm-checks">
                            <label class="hm-check"><input asp-for="Schedule"><span>@T["Daily schedule"]<small>@T["Today's matches for followed teams"]</small></span></label>
                            <label class="hm-check"><input asp-for="Reminders"><span>@T["Reminders"]<small>@T["Before a match, using the lead time"]</small></span></label>
                            <label class="hm-check"><input asp-for="MatchStarts"><span>@T["Match starts"]<small>@T["When a followed match goes live"]</small></span></label>
                            <label class="hm-check"><input asp-for="Maps"><span>@T["Map results"]<small>@T["After each map"]</small></span></label>
                            <label class="hm-check"><input asp-for="Results"><span>@T["Match results"]<small>@T["Final score"]</small></span></label>
                        </div>
                    </fieldset>
                </div>
            </section>

            <partial name="_GameSettings" for="Cs" view-data="csData" />
            <partial name="_GameSettings" for="Dota" view-data="dotaData" />
        </div>
    </div>

    <div class="hm-savebar">
        <div class="hm-savebar__inner">
            <span class="hm-savebar__status" aria-live="polite">
                @if (failed)
                {
                    <span class="hm-savebar__dirty"><b aria-hidden="true">●</b>@T["Unsaved changes"]<span aria-hidden="true">·</span><span style="color: var(--hm-danger); font-weight: 600">@(fieldErrors.Length > 0 ? T["{0} to fix", fieldErrors.Length] : T["Not saved"])</span></span>
                }
                else
                {
                    <span class="hm-savebar__clean">@DashboardIcons.Render("check", "color: var(--hm-mint)")@T["No unsaved changes"]</span>
                    <span class="hm-savebar__dirty"><b aria-hidden="true">●</b>@T["Unsaved changes"]</span>
                }
            </span>
            <a class="hm-btn hm-btn--ghost hm-savebar__dirty" href="/settings/@settingsPage.GuildId">@T["Discard"]</a>
            <button class="hm-btn hm-btn--primary">@DashboardIcons.Render("check")@T["Save settings"]</button>
        </div>
    </div>
</form>

<datalist id="time-zones">
    @foreach (var zone in HappyMix.Bot.Interactions.AvailabilityTimeZoneAutocomplete.Names)
    {
        <option value="@zone"></option>
    }
</datalist>
