@model ServerSettingsForm
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = T["Server_settings"];
    var settingsPage = (SettingsPage)ViewData["Settings"]!;
    ViewData["NavGuildName"] = settingsPage.GuildName;
    var state = ViewData.ModelState;
    var nav = new ServerNavModel(settingsPage.GuildId, settingsPage.GuildName, "settings", true, "Server settings",
        T["Where_and_when_HappyMix_posts_esports_announcements_Only_server_administrators_see_this"]);

    var labels = new Dictionary<string, string>
    {
        ["ChannelId"] = $"{T["Server_defaults"]} · {T["Announcement_channel"]}",
        ["TimeZone"] = $"{T["Server_defaults"]} · {T["Time_zone"]}",
        ["ReminderMinutes"] = $"{T["Server_defaults"]} · {T["Reminder_lead_time"]}",
        ["OrganizerRoles"] = $"{T["Server_defaults"]} · {T["Organizer_roles"]}",
    };
    foreach (var (prefix, game) in new[] { ("Cs", "Counter-Strike 2"), ("Dota", "Dota 2") })
    {
        labels[$"{prefix}.Channel"] = $"{game} · {T["Announcement_channel"]}";
        labels[$"{prefix}.PingRole"] = $"{game} · {T["Reminder_ping_role"]}";
        labels[$"{prefix}.Teams"] = $"{game} · {T["Followed_teams"]}";
        labels[$"{prefix}.Twitch"] = $"{game} · {T["Twitch_channels"]}";
        labels[$"{prefix}.Catalog"] = $"{game} · {T["Team_aliases"]}";
    }

    var fieldErrors = state.Where(entry => entry.Key.Length > 0 && entry.Value?.Errors.Count > 0).Select(entry => entry.Key).ToArray();
    var generalErrors = state.TryGetValue("", out var general) ? general.Errors.Select(error => error.ErrorMessage).ToArray() : Array.Empty<string>();
    int csErrors = fieldErrors.Count(key => key.StartsWith("Cs.", StringComparison.Ordinal));
    int dotaErrors = fieldErrors.Count(key => key.StartsWith("Dota.", StringComparison.Ordinal));
    int defaultErrors = fieldErrors.Length - csErrors - dotaErrors;
    bool failed = fieldErrors.Length > 0 || generalErrors.Length > 0;

    BannerModel? banner = settingsPage.Banner;
    if (failed)
    {
        string title = fieldErrors.Length switch
        {
            0 => T["Settings_not_saved"].Value,
            1 => T["Settings_not_saved_1_field_needs_attention"].Value,
            var count => T["Settings_not_saved_Arg0_fields_need_attention", count].Value
        };
        banner = new BannerModel("error", title, generalErrors.Length > 0 ? string.Join(" ", generalErrors) : null, true,
            fieldErrors.Select(key => (labels.GetValueOrDefault(key, key), "#" + FormErrors.Id(key) + (key.EndsWith(".Catalog") ? "-details" : ""))).ToList());
    }

    var csData = new ViewDataDictionary(ViewData) { ["GameTitle"] = "Counter-Strike 2", ["GameMark"] = "CS2", ["GameDefaults"] = settingsPage.CounterStrike, ["SectionId"] = "cs2" };
    var dotaData = new ViewDataDictionary(ViewData) { ["GameTitle"] = "Dota 2", ["GameMark"] = "D2", ["GameDefaults"] = settingsPage.Dota, ["SectionId"] = "dota2" };
}

<partial name="_ServerNav" model="nav" />

<form method="post" action="/settings/@settingsPage.GuildId" asp-antiforgery="false" data-track-changes data-dirty="@(failed ? "true" : "false")">
    @Html.AntiForgeryToken()
    <div class="hm-split hm-split--nav">
        <nav class="hm-sidenav" aria-label="@T["Settings_sections"]">
            <a href="#defaults">@T["Server_defaults"]
                @if (defaultErrors > 0)
                {
                    <span class="hm-badge hm-badge--danger" aria-label="@T["Arg0_to_fix", defaultErrors]">@defaultErrors</span>
                }
            </a>
            <a href="#cs2">Counter-Strike 2
                @if (csErrors > 0)
                {
                    <span class="hm-badge hm-badge--danger" aria-label="@T["Arg0_to_fix", csErrors]">@csErrors</span>
                }
            </a>
            <a href="#dota2">Dota 2
                @if (dotaErrors > 0)
                {
                    <span class="hm-badge hm-badge--danger" aria-label="@T["Arg0_to_fix", dotaErrors]">@dotaErrors</span>
                }
            </a>
            <p class="hm-help" style="padding: var(--hm-space-3) var(--hm-space-3) 0; font-size: var(--hm-fs-xs)">@T["Game_sections_inherit_from_Server_defaults_unless_you_override_a_value"]</p>
        </nav>

        <div class="hm-stack" style="gap: var(--hm-space-6); min-width: 0">
            @if (banner is not null)
            {
                <partial name="_Banner" model="banner" />
            }
            @if (settingsPage.Channels.Length == 0)
            {
                <div class="hm-banner hm-banner--warn">
                    <span class="hm-banner__icon">@DashboardIcons.Render("bang")</span>
                    <div class="hm-banner__body">
                        <p class="hm-banner__title">@T["HappyMix_can_t_post_in_any_text_channel_yet"]</p>
                        <p class="hm-banner__text">@T["In_Discord_give_the_HappyMix_role_View_Channel_Send_Messages_and_Embed"]</p>
                    </div>
                </div>
            }

            @if (settingsPage.Routes.Length > 0)
            {
                <section class="hm-card hm-routes" id="routes" aria-labelledby="routes-title">
                    <div class="hm-row hm-row--between">
                        <h2 id="routes-title">@DashboardIcons.Render("bell")@T["Routes_Title"]</h2>
                        <span class="hm-help">@T["Routes_Help"]</span>
                    </div>
                    <ul class="hm-routes__list">
                        @foreach (var route in settingsPage.Routes)
                        {
                            <li class="hm-routes__item @(route.Warnings.Length > 0 ? "hm-routes__item--warn" : "")">
                                <span class="hm-routes__channel">@route.Channel</span>
                                <span class="hm-routes__games">
                                    @foreach (var game in route.Games)
                                    {
                                        <a class="hm-tag hm-tag--@game.Section" href="#@game.Section">@game.Name<small>@game.Language</small></a>
                                    }
                                </span>
                                @foreach (var warning in route.Warnings)
                                {
                                    <p class="hm-routes__warning">@DashboardIcons.Render("bang")<span>@warning</span></p>
                                }
                                @if (route.Fixes.Length > 0)
                                {
                                    <span class="hm-routes__fixes">
                                        @foreach (var fix in route.Fixes)
                                        {
                                            <button type="button" class="hm-btn hm-btn--sm" data-route-fix="@fix.CheckboxId">@T["Routes_OwnChannel", fix.Game]</button>
                                        }
                                    </span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="hm-card hm-section" id="defaults" aria-labelledby="defaults-title">
                <div class="hm-section__head">
                    <span class="hm-game-mark" aria-hidden="true">@DashboardIcons.Render("sliders")</span>
                    <div><h2 id="defaults-title">@T["Server_defaults"]</h2><p>@T["Used_by_every_game_unless_the_game_overrides_it"]</p></div>
                </div>
                <div class="hm-fields">
                    <div class="hm-field">
                        <label class="hm-label" asp-for="ChannelId">@T["Announcement_channel"]</label>
                        <select class="hm-select" asp-for="ChannelId" asp-items="settingsPage.Channels" data-picker
                                data-picker-search="@T["Find_a_channel"]" data-picker-empty="@T["No_channels_match"]"
                                aria-invalid="@FormErrors.Invalid(state, "ChannelId")" aria-describedby="@FormErrors.DescribedBy(state, "ChannelId", "ChannelId-help")">
                            <option value="0">@T["Bot_default_Arg0", settingsPage.DeploymentChannel]</option>
                        </select>
                        <p class="hm-help" id="ChannelId-help">@T["Text_channels_where_HappyMix_can_view_send_messages_and_embed_links"]</p>
                        @FormErrors.Render(state, "ChannelId")
                    </div>
                    <div class="hm-field">
                        <label class="hm-label" asp-for="TimeZone">@T["Time_zone"]</label>
                        <input class="hm-input" asp-for="TimeZone" list="time-zones" autocomplete="off" spellcheck="false" placeholder="Europe/Kyiv"
                               aria-invalid="@FormErrors.Invalid(state, "TimeZone")" aria-describedby="@FormErrors.DescribedBy(state, "TimeZone", "TimeZone-help")">
                        <p class="hm-help" id="TimeZone-help">@T["Used_for_schedules_and_availability_Start_typing_a_city_like_Kyiv_or"]</p>
                        @FormErrors.Render(state, "TimeZone")
                    </div>
                    <div class="hm-field">
                        <label class="hm-label" asp-for="ReminderMinutes">@T["Reminder_lead_time"]</label>
                        <div class="hm-affix" style="max-width: 14rem">
                            <input class="hm-input hm-tnum" asp-for="ReminderMinutes" min="1" max="1440" inputmode="numeric"
                                   aria-invalid="@FormErrors.Invalid(state, "ReminderMinutes")" aria-describedby="@FormErrors.DescribedBy(state, "ReminderMinutes", "ReminderMinutes-help")">
                            <span class="hm-affix__text">@T["Minutes"]</span>
                        </div>
                        <p class="hm-help" id="ReminderMinutes-help">@T["Before_a_followed_match_1_1440"]</p>
                        @FormErrors.Render(state, "ReminderMinutes")
                    </div>
                    <fieldset class="hm-field" id="OrganizerRoles" style="border: 0; padding: 0; margin: 0"
                              aria-describedby="@FormErrors.DescribedBy(state, "OrganizerRoles", "OrganizerRoles-help")">
                        <legend class="hm-label" style="margin-bottom: var(--hm-space-2)">@T["Organizer_roles"] <span class="hm-label__opt">@T["Optional"]</span></legend>
                        @if (settingsPage.Roles.Length == 0)
                        {
                            <p class="hm-help">@T["This_server_has_no_roles_yet"]</p>
                        }
                        else
                        {
                            <div class="hm-checkbox-box">
                                @foreach (var role in settingsPage.Roles)
                                {
                                    <label class="hm-check"><input type="checkbox" name="OrganizerRoles" value="@role.Id" checked="@Model.OrganizerRoles.Contains(role.Id)"><span class="hm-role-dot" style="background: @role.Color"></span>@role.Name</label>
                                }
                            </div>
                        }
                        <p class="hm-help" id="OrganizerRoles-help" style="margin-top: var(--hm-space-2)">@T["With_none_selected_any_member_can_organize_a_group"]</p>
                        @FormErrors.Render(state, "OrganizerRoles")
                    </fieldset>
                    <fieldset class="hm-field hm-field--wide" style="border: 0; padding: 0; margin: 0">
                        <legend class="hm-label" style="margin-bottom: var(--hm-space-2)">@T["Post_to_the_channel"]</legend>
                        <div class="hm-checks">
                            <label class="hm-check"><input asp-for="Schedule"><span>@T["Daily_schedule"]<small>@T["Today_s_matches_for_followed_teams"]</small></span></label>
                            <label class="hm-check"><input asp-for="Reminders"><span>@T["Reminders"]<small>@T["Before_a_match_using_the_lead_time"]</small></span></label>
                            <label class="hm-check"><input asp-for="MatchStarts"><span>@T["Match_starts"]<small>@T["When_a_followed_match_goes_live"]</small></span></label>
                            <label class="hm-check"><input asp-for="Maps"><span>@T["Map_results"]<small>@T["After_each_map"]</small></span></label>
                            <label class="hm-check"><input asp-for="Results"><span>@T["Match_results"]<small>@T["Final_score"]</small></span></label>
                        </div>
                    </fieldset>
                </div>
            </section>

            <partial name="_GameSettings" for="Cs" view-data="csData" />
            <partial name="_GameSettings" for="Dota" view-data="dotaData" />
        </div>
    </div>

    <div class="hm-savebar">
        <div class="hm-savebar__inner">
            <span class="hm-savebar__status" aria-live="polite">
                @if (failed)
                {
                    <span class="hm-savebar__dirty"><b aria-hidden="true">●</b>@T["Unsaved_changes"]<span aria-hidden="true">·</span><span style="color: var(--hm-danger); font-weight: 600">@(fieldErrors.Length > 0 ? T["Arg0_to_fix", fieldErrors.Length] : T["Not_saved"])</span></span>
                }
                else
                {
                    <span class="hm-savebar__clean">@DashboardIcons.Render("check", "color: var(--hm-mint)")@T["No_unsaved_changes"]</span>
                    <span class="hm-savebar__dirty"><b aria-hidden="true">●</b>@T["Unsaved_changes"]</span>
                }
            </span>
            <a class="hm-btn hm-btn--ghost hm-savebar__dirty" href="/settings/@settingsPage.GuildId">@T["Discard"]</a>
            <button class="hm-btn hm-btn--primary">@T["Save_settings"]</button>
        </div>
    </div>
</form>

<datalist id="time-zones">
    @foreach (var zone in HappyMix.Bot.Interactions.AvailabilityTimeZoneAutocomplete.Names)
    {
        <option value="@zone"></option>
    }
</datalist>
