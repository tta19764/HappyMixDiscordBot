@using HappyMix.Bot.Interactions
@model InfoPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = T["Guide_Title"];
    ViewData["NavGuildName"] = Model.GuildName;
    var modules = Model.Commands.GroupBy(command => command.Path.Contains(' ') ? command.Path.Split(' ')[0] : "general");
}
<nav class="hm-crumbs" aria-label="@T["Breadcrumb"]">
    <a href="/">@T["Servers"]</a><span aria-hidden="true">/</span>
    @if (Model.GuildId is { } guildId)
    {
        <a href="/availability/@guildId">@Model.GuildName</a><span aria-hidden="true">/</span>
    }
    <span>@T["Guide_Title"]</span>
</nav>
<header class="hm-page-head">
    <div><h1>@T["Guide_Title"]</h1><p>@T["Browse_Discord_commands_workflows_and_options"]</p></div>
    @if (Model.GuildId is { } backId)
    {
        <a class="hm-btn" href="/availability/@backId">@DashboardIcons.Render("back")<span>@T["Back_to_Arg0", Model.GuildName!]</span></a>
    }
    else
    {
        <a class="hm-btn" href="/">@DashboardIcons.Render("back")<span>@T["Choose_a_server"]</span></a>
    }
</header>
<nav class="hm-card hm-row" style="flex-wrap:wrap;margin-bottom:24px" aria-label="@T["Guide_Title"]">
    @foreach (string feature in new[] { "overview", "availability", "vacation", "weekly", "groups", "votes", "events", "game-news", "links", "settings", "logs" })
    {
        <a href="#feature-@feature">@T[$"Guide_{feature}_Title"]</a>
    }
</nav>
<div class="hm-stack" style="margin-bottom:24px">
    @foreach (string feature in new[] { "overview", "availability", "vacation", "weekly", "groups", "votes", "events", "game-news", "links", "settings", "logs" })
    {
        <section class="hm-card hm-stack" id="feature-@feature">
            <h2>@T[$"Guide_{feature}_Title"]</h2>
            <p>@T[$"Guide_{feature}_Body"]</p>
        </section>
    }
</div>
<div class="hm-guide">
    <nav class="hm-card hm-sidenav hm-guide__nav" aria-label="@T["Command_modules"]">
        @foreach (var module in modules)
        {
            <a href="#commands-@module.Key">@module.Key <span class="hm-count">@module.Count()</span></a>
        }
    </nav>
    <div class="hm-stack">
        @foreach (var module in modules)
        {
            <section class="hm-card hm-stack" id="commands-@module.Key">
                <header class="hm-stack hm-stack--sm"><h2 class="hm-guide__title">@module.Key</h2><p class="hm-muted">@T.Message(CommandHelp.Flow(module.Key))</p></header>
                @foreach (var command in module)
                {
                    <details class="hm-guide__command">
                        <summary><code>/@command.Path</code><span class="hm-muted">@T.Message(command.Description)</span></summary>
                        @if (command.Flow.Length > 0)
                        {
                            <p>@T.Message(command.Flow)</p>
                        }
                        @if (command.Options.Length > 0)
                        {
                            <dl class="hm-impact hm-guide__options">
                                @foreach (var option in command.Options)
                                {
                                    <dt><code>@option.Name</code> <small class="hm-badge">@T.Message(option.IsRequired ? "Required" : "Optional")</small></dt>
                                    <dd>@T.Message(option.Description)</dd>
                                }
                            </dl>
                        }
                    </details>
                }
            </section>
        }
    </div>
</div>
