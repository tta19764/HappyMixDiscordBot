@using HappyMix.Bot.Interactions
@model InfoPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = T["Command guide"];
    ViewData["NavGuildName"] = Model.GuildName;
    var modules = Model.Commands.GroupBy(command => command.Path.Contains(' ') ? command.Path.Split(' ')[0] : "general");
}
<nav class="hm-crumbs" aria-label="@T["Breadcrumb"]">
    <a href="/">@T["Servers"]</a><span aria-hidden="true">/</span>
    @if (Model.GuildId is { } guildId)
    {
        <a href="/availability/@guildId">@Model.GuildName</a><span aria-hidden="true">/</span>
    }
    <span>@T["Command guide"]</span>
</nav>
<header class="hm-page-head">
    <div><h1>@T["Command guide"]</h1><p>@T["Browse Discord commands, workflows, and options."]</p></div>
    @if (Model.GuildId is { } backId)
    {
        <a class="hm-btn" href="/availability/@backId">@DashboardIcons.Render("back")<span>@T["Back to {0}", Model.GuildName!]</span></a>
    }
    else
    {
        <a class="hm-btn" href="/">@DashboardIcons.Render("back")<span>@T["Choose a server"]</span></a>
    }
</header>
<div class="hm-guide">
    <nav class="hm-card hm-sidenav hm-guide__nav" aria-label="@T["Command modules"]">
        @foreach (var module in modules)
        {
            <a href="#commands-@module.Key">@module.Key <span class="hm-count">@module.Count()</span></a>
        }
    </nav>
    <div class="hm-stack">
        @foreach (var module in modules)
        {
            <section class="hm-card hm-stack" id="commands-@module.Key">
                <header class="hm-stack hm-stack--sm"><h2 class="hm-guide__title">@module.Key</h2><p class="hm-muted">@T[CommandHelp.Flow(module.Key)]</p></header>
                @foreach (var command in module)
                {
                    <details class="hm-guide__command">
                        <summary><code>/@command.Path</code><span class="hm-muted">@T[command.Description]</span></summary>
                        @if (command.Flow.Length > 0)
                        {
                            <p>@T[command.Flow]</p>
                        }
                        @if (command.Options.Length > 0)
                        {
                            <dl class="hm-impact hm-guide__options">
                                @foreach (var option in command.Options)
                                {
                                    <dt><code>@option.Name</code> <small class="hm-badge">@T[option.IsRequired ? "Required" : "Optional"]</small></dt>
                                    <dd>@T[option.Description]</dd>
                                }
                            </dl>
                        }
                    </details>
                }
            </section>
        }
    </div>
</div>
