@using System.Globalization
@model LinksPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = T["Linked_accounts"];
    ViewData["NavGuildName"] = Model.GuildName;
    var view = Model.View;
    string Localize(string key) => T.Message(key);
    var nav = new ServerNavModel(Model.GuildId, Model.GuildName, "links", Model.Viewer.CanConfigure, "Linked accounts",
        T["Connect_an_alternate_account_twink_so_HappyMix_treats_both_as_one_member"]);
    var zone = TimeZoneInfo.TryFindSystemTimeZoneById(Model.TimeZone, out var found) ? found : TimeZoneInfo.Utc;
    string Time(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, zone).ToString("d MMM HH:mm", CultureInfo.CurrentCulture);
    var primary = Model.Names.Get(view.PrimaryId);
    string primaryName = Model.Names.Name(view.PrimaryId, Localize);
}

<partial name="_ServerNav" model="nav" />
@if (Model.Viewer.CanConfigure)
{
    <partial name="_LinkTabs" model="(Model.GuildId, false)" />
}


@if (Model.Banner is { } banner)
{
    <div style="margin-bottom: var(--hm-space-4)"><partial name="_Banner" model="banner" /></div>
}

<div class="hm-split">
    <div class="hm-stack" style="gap: var(--hm-space-5)">
        <section class="hm-card hm-stack" aria-labelledby="family-title">
            <div class="hm-card__head" style="margin: 0">
                <div>
                    <h2 id="family-title">@T["Your_accounts"]</h2>
                    <p>@T["All_accounts_below_act_as_one_member_the_same_groups_invitations_and"]</p>
                </div>
            </div>
            <ul class="hm-roster">
                <li class="hm-roster__item">
                    <partial name="_Avatar" model="new AvatarModel(primary, primaryName)" />
                    <div class="hm-roster__who">
                        <span class="hm-roster__name">@primaryName <span class="hm-badge hm-badge--custom">@T["Primary"]</span>
                            @if (view.Viewer == view.PrimaryId)
                            {
                                <span class="hm-badge">@T["You"]</span>
                            }
                        </span>
                        <span class="hm-roster__sub">@(primary.Username is { } u ? "@" + u : "")</span>
                    </div>
                </li>
                @foreach (var link in view.Alternates)
                {
                    var profile = Model.Names.Get(link.AlternateId);
                    string name = Model.Names.Name(link.AlternateId, Localize);
                    <li class="hm-roster__item">
                        <partial name="_Avatar" model="new AvatarModel(profile, name)" />
                        <div class="hm-roster__who">
                            <span class="hm-roster__name">@name <span class="hm-badge hm-badge--inherit">@T["Alternate_twink"]</span>
                                @if (view.Viewer == link.AlternateId)
                                {
                                    <span class="hm-badge">@T["You"]</span>
                                }
                            </span>
                            <span class="hm-roster__sub">@T["Linked_Arg0", Time(link.LinkedAt)]</span>
                        </div>
                        @if (view.ViewerIsPrimary || view.Viewer == link.AlternateId)
                        {
                            <div class="hm-roster__actions">
                                <a class="hm-btn hm-btn--danger" href="/links/@Model.GuildId/unlink/@link.AlternateId" aria-label="@T["Unlink_Arg0", name]">
                                    @DashboardIcons.Render("trash")<span class="hm-btn__label">@T["Unlink"]</span>
                                </a>
                            </div>
                        }
                    </li>
                }
            </ul>
            @if (view.Alternates.Length == 0)
            {
                <p class="hm-help">@T["No_alternate_accounts_are_linked_yet"]</p>
            }
        </section>

        @if (view.ViewerIsPrimary)
        {
            <section class="hm-card hm-stack" id="new-link" aria-labelledby="new-link-title">
                <h2 id="new-link-title">@T["Link_an_alternate_account"]</h2>
                @if (Model.NewLinkUrl is { } url)
                {
                    <div class="hm-banner hm-banner--success" role="status" tabindex="-1" data-focus-on-load>
                        <span class="hm-banner__icon">@DashboardIcons.Render("check")</span>
                        <div class="hm-banner__body">
                            <p class="hm-banner__title">@T["Link_created"]</p>
                            <p class="hm-banner__text">@T["Open_it_while_signed_in_to_Discord_as_your_alternate_account_twink", Model.NewLinkExpires is { } expires ? Time(expires) : ""]</p>
                        </div>
                    </div>
                    <div class="hm-search" style="max-width: none">
                        <label class="hm-sr-only" for="link-url">@T["Link_for_your_alternate_account"]</label>
                        <input class="hm-input" id="link-url" value="@url" readonly spellcheck="false" data-copy-source>
                        <button class="hm-btn" type="button" data-copy="link-url" hidden>@T["Copy"]</button>
                    </div>
                    <p class="hm-help">@T["This_page_shows_the_link_only_once_Don_t_share_it_with"]</p>
                }
                <ol class="hm-steps">
                    <li>@T["Create_a_link_here_signed_in_as_your_main_account"]</li>
                    <li>@T["Open_the_link_signed_in_to_Discord_as_your_alternate_account_twink"]</li>
                    <li>@T["Review_what_will_be_shared_and_approve_it_from_the_alternate_account"]</li>
                </ol>
                @if (view.CanCreateRequest)
                {
                    <form method="post" action="/links/@Model.GuildId/requests" asp-antiforgery="false">
                        @Html.AntiForgeryToken()
                        <button class="hm-btn hm-btn--primary">@DashboardIcons.Render("plus")@T["Create_link"]</button>
                    </form>
                }
                else
                {
                    <p class="hm-help">@T.Message(view.CannotCreateReason!)</p>
                }

                @if (view.Requests.Length > 0)
                {
                    <h3>@T["Open_link_requests"]</h3>
                    <ul class="hm-roster">
                        @foreach (var request in view.Requests)
                        {
                            <li class="hm-roster__item">
                                <div class="hm-roster__who">
                                    <span class="hm-roster__name">@T["Created_Arg0", Time(request.CreatedAt)]</span>
                                    <span class="hm-roster__sub">@T["Expires_Arg0_works_once", Time(request.ExpiresAt)]</span>
                                </div>
                                <form method="post" action="/links/@Model.GuildId/requests/@request.Id/revoke" asp-antiforgery="false">
                                    @Html.AntiForgeryToken()
                                    <button class="hm-btn hm-btn--ghost">@T["Revoke"]</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        else
        {
            <section class="hm-card">
                <p class="hm-help">@T["This_account_is_the_alternate_twink_of_Arg0_New_links_are_created", primaryName]</p>
            </section>
        }
    </div>

    <aside class="hm-card hm-stack hm-stack--sm" aria-labelledby="rules-title">
        <h2 id="rules-title" style="font-size: var(--hm-fs-lg)">@T["What_linking_does"]</h2>
        <ul class="hm-help hm-ticks">
            <li>@T["Groups_invitations_and_organizer_rights_are_shared_and_counted_once"]</li>
            <li>@T["Today_weekly_and_all_day_availability_is_one_schedule_Editing_from_either"]</li>
            <li>@T["Group_roles_in_Discord_are_given_to_every_linked_account"]</li>
            <li><strong>@T["Discord_permissions_are_never_shared"]</strong> @T["Admin_and_moderator_access_still_depends_on_the_account_you_sign_in"]</li>
            <li>@T["Links_only_apply_in_this_server"]</li>
        </ul>
    </aside>
</div>
