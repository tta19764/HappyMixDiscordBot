# Save the populated file ONLY as /opt/happymix/bot.env on the VM, mode 600.
DOTNET_ENVIRONMENT=Production
Discord__Token=replace-on-server
Discord__AnnouncementChannelId=replace-on-server
PandaScore__Token=replace-on-server
Storage__DatabasePath=/app/data/happymix.db
Storage__ReplayExistingResultsOnFirstRun=false
# Optional: enables film search and IMDb film links (https://www.themoviedb.org/settings/api). Games, series and anime work without it.
# Media__TmdbApiKey=replace-on-server
# Optional: imports Steam libraries on My games (https://steamcommunity.com/dev/apikey). Linking Steam and adding games by hand work without it.
# Steam__ApiKey=replace-on-server
# Optional: Live reads Discord "Playing" statuses. Turn on "Presence Intent" in the Discord Developer Portal (Bot page) FIRST,
# or Discord refuses the connection. Without it, Live uses Steam statuses only (needs Steam__ApiKey).
# Live__DiscordPresence=true
# Optional: CS2 stats cards (FACEIT level, Elo, K/D) on groups that play CS2. Free server key from developers.faceit.com.
# Faceit__ApiKey=replace-on-server
# Optional: Dota 2 stats come from OpenDota without a key; a key only raises its rate limits.
# OpenDota__ApiKey=replace-on-server
# Optional: the Dota 2 meta search by patch, role and rank on Game features (free token from stratz.com/api). Without it the
# page shows the meta by lane from OpenDota.
# Stratz__ApiKey=replace-on-server
# Optional: Discord user ids that may also see bot-wide entries (not tied to a server) in the Logs tab.
# Logs__OwnerIds__0=replace-on-server
